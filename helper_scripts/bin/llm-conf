#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "textual>=8.2,<9",
# ]
# ///

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from pathlib import Path
from typing import ClassVar

import tomllib
from textual.app import App, ComposeResult
from textual.widgets import (
    Footer,
    Header,
    OptionList,
    RadioButton,
    RadioSet,
    Static,
    TabbedContent,
    TabPane,
)
from textual.widgets.option_list import Option

PROVIDER_VARIABLE = "CODEXR_PROVIDER"
# The tmux environment has no pane scope, so a per-pane override rides on a
# pane-local user option instead. codexr reads it ahead of the environment.
PROVIDER_PANE_OPTION = "@codexr_provider"
# clauder's provider: the name of a settings file under CLAUDER_PROVIDER_DIR
# that clauder layers on ~/.claude/settings.json via `claude --settings`.
# Same three scopes as codexr, same carriers.
CLAUDER_PROVIDER_VARIABLE = "CLAUDER_PROVIDER"
CLAUDER_PROVIDER_PANE_OPTION = "@clauder_provider"
CLAUDER_PROVIDER_DIR = Path(
    os.environ.get("CLAUDER_PROVIDER_DIR", Path.home() / ".claude/providers")
)
AI_TOOL_VARIABLE = "TMUX_AI_TOOL"
# Not CLAUDE_DEFAULT_MODEL itself: the tmux global environment is a snapshot
# of the server-starting shell, so a variable that shells export (env.local
# does) would shadow later env.local edits forever. clauder falls back to the
# shell's CLAUDE_DEFAULT_MODEL when no TMUX_CLAUDE_MODEL override is set.
CLAUDE_MODEL_VARIABLE = "TMUX_CLAUDE_MODEL"
CLAUDE_DEFAULT_VARIABLE = "CLAUDE_DEFAULT_MODEL"
# Same carrier as @codexr_provider: the tmux environment has no pane scope,
# so the per-pane model override rides on a pane-local user option. clauder
# reads it ahead of the tmux environment; only an explicit launcher
# TMUX_AI_MODEL outranks it.
CLAUDE_MODEL_PANE_OPTION = "@claude_model"
# Gateway model names (see /v1/models on models.llm.jt). The [1m] suffix is
# Claude Code's notation for the 1M context window.
CLAUDE_MODEL_CHOICES = (
    ("Claude Fable 5.1 CAVEAT[1m]", "Fable 5.1 — 1M context"),
    ("claude-opus-5-5[1m]", "Opus 5.5 — 1M context (TrueFoundry name; needs claude >= 2.1.280)"),
    ("claude-fable-5[1m]", "Fable 5 — 1M context"),
    ("claude-opus-5[1m]", "Opus 5 — 1M context"),
    ("Claude Sonnet 5", "Sonnet 5"),
    ("inherit", "inherit — remove the selected-scope override"),
)
STATIC_CHOICES = (
    ("lb8121", "lb8121 — shared 8121 endpoint"),
    ("azure", "azure — Azure OpenAI from keys/gpt.gpg"),
    ("openai", "openai — official OpenAI login (default)"),
    ("xyz", "xyz — XYZ normally, Azure inside Obsidian"),
)
SCOPES = (
    ("pane", "Current pane"),
    ("session", "Current session"),
    ("global", "Global tmux server"),
)
AI_TOOL_CHOICES = (
    ("codex", "codex — launch Codex with codexr"),
    ("gemini", "gemini — launch Gemini"),
    ("claude", "claude — launch Claude Code with clauder"),
)


class ToolError(RuntimeError):
    pass


def provider_choices() -> tuple[tuple[str, str], ...]:
    config_path = (
        Path(os.environ.get("CODEX_HOME", Path.home() / ".codex")) / "config.toml"
    )
    configured: list[tuple[str, str]] = []

    if config_path.exists():
        try:
            with config_path.open("rb") as config_file:
                config = tomllib.load(config_file)
        except (OSError, tomllib.TOMLDecodeError) as error:
            raise ToolError(f"cannot read {config_path}: {error}") from error

        providers = config.get("model_providers", {})
        if not isinstance(providers, dict):
            raise ToolError(f"model_providers in {config_path} must be a table")
        for provider_id, provider in providers.items():
            if not re.fullmatch(r"[A-Za-z0-9_-]+", provider_id):
                raise ToolError(
                    f"unsupported provider id in {config_path}: {provider_id!r}"
                )
            if not isinstance(provider, dict):
                raise ToolError(
                    f"model_providers.{provider_id} in {config_path} must be a table"
                )
            display_name = provider.get("name") or provider_id
            configured.append((provider_id, f"{provider_id} — {display_name} (config)"))

    choices = list(STATIC_CHOICES)
    known = {value for value, _ in choices}
    choices.extend(choice for choice in configured if choice[0] not in known)
    choices.append(("inherit", "inherit — remove the selected-scope override"))
    return tuple(choices)


def clauder_provider_choices() -> tuple[tuple[str, str], ...]:
    # One choice per settings file; the label shows where it points and its
    # default model so the gateway-specific model names are visible here.
    if not CLAUDER_PROVIDER_DIR.is_dir():
        raise ToolError(f"clauder provider directory missing: {CLAUDER_PROVIDER_DIR}")
    choices: list[tuple[str, str]] = []
    for path in sorted(CLAUDER_PROVIDER_DIR.glob("*.json")):
        provider_id = path.stem
        if not re.fullmatch(r"[A-Za-z0-9_-]+", provider_id):
            raise ToolError(f"unsupported provider file name: {path}")
        try:
            settings = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError) as error:
            raise ToolError(f"cannot read {path}: {error}") from error
        base_url = settings.get("env", {}).get("ANTHROPIC_BASE_URL", "<no base url>")
        model = settings.get("model") or "<no default model>"
        choices.append((provider_id, f"{provider_id} — {base_url}  model {model}"))
    if not choices:
        raise ToolError(f"no provider settings files in {CLAUDER_PROVIDER_DIR}")
    choices.append(("inherit", "inherit — remove the selected-scope override"))
    return tuple(choices)


def run_tmux(*args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        ["tmux", *args], capture_output=True, text=True, check=False
    )
    if check and result.returncode:
        raise ToolError(
            result.stderr.strip() or f"tmux exited with {result.returncode}"
        )
    return result


def current_pane() -> str:
    pane = os.environ.get("TMUX_PANE")
    if not os.environ.get("TMUX") or not pane:
        raise ToolError("must run inside a tmux pane")
    return pane


def current_session(pane: str) -> str:
    return run_tmux("display-message", "-p", "-t", pane, "#S").stdout.strip()


def read_variable(variable: str, *scope: str) -> str | None:
    result = run_tmux("show-environment", *scope, variable, check=False)
    line = result.stdout.strip()
    if line.startswith(f"{variable}="):
        return line.split("=", 1)[1]
    if result.returncode and "unknown variable" not in result.stderr:
        raise ToolError(result.stderr.strip())
    return None


def read_pane_option(pane: str, option: str) -> str | None:
    # -q keeps an unset option quiet, so an empty result means "not set".
    result = run_tmux("show-option", "-pqv", "-t", pane, option, check=False)
    return result.stdout.strip() or None


def set_scoped(
    scope: str,
    session: str,
    pane: str,
    value: str,
    pane_option: str,
    variable: str,
) -> None:
    if scope == "pane":
        if value == "inherit":
            run_tmux("set-option", "-pu", "-t", pane, pane_option)
        else:
            run_tmux("set-option", "-p", "-t", pane, pane_option, value)
        return

    target = ["-g"] if scope == "global" else ["-t", session]
    if value == "inherit":
        run_tmux("set-environment", *target, "-r", variable)
    else:
        run_tmux("set-environment", *target, variable, value)


def set_provider(scope: str, session: str, pane: str, value: str) -> None:
    set_scoped(scope, session, pane, value, PROVIDER_PANE_OPTION, PROVIDER_VARIABLE)


def set_clauder_provider(scope: str, session: str, pane: str, value: str) -> None:
    set_scoped(
        scope,
        session,
        pane,
        value,
        CLAUDER_PROVIDER_PANE_OPTION,
        CLAUDER_PROVIDER_VARIABLE,
    )


def set_claude_model(scope: str, session: str, pane: str, value: str) -> None:
    set_scoped(
        scope, session, pane, value, CLAUDE_MODEL_PANE_OPTION, CLAUDE_MODEL_VARIABLE
    )


def set_ai_tool(value: str) -> None:
    run_tmux("set-environment", "-g", AI_TOOL_VARIABLE, value)


class ProviderApp(App[None]):
    TITLE = "Tmux AI settings"
    CSS = """
    TabbedContent { height: 1fr; }
    .status { margin: 1 2; padding: 1 2; border: round $accent; }
    #scope, #clauder-scope, #claude-scope { margin: 0 2 1 2; height: 3; layout: horizontal; border: round $secondary; }
    #scope RadioButton, #clauder-scope RadioButton, #claude-scope RadioButton { width: 1fr; }
    .choices { margin: 0 2 1 2; height: auto; border: round $primary; }
    """
    BINDINGS: ClassVar[list[tuple[str, str, str]]] = [
        ("right", "apply", "Apply"),
        ("1", "show_tab('provider-tab')", "Codex provider"),
        ("2", "show_tab('clauder-tab')", "Claude provider"),
        ("3", "show_tab('claude-tab')", "Claude model"),
        ("4", "show_tab('ai-tool-tab')", "AI tool"),
        ("r", "refresh", "Refresh"),
        ("left,escape,q", "quit", "Quit"),
    ]

    def __init__(
        self,
        pane: str,
        session: str,
        choices: tuple[tuple[str, str], ...],
        clauder_choices: tuple[tuple[str, str], ...],
    ) -> None:
        super().__init__()
        self.pane = pane
        self.session = session
        self.scope = "pane"
        self.clauder_scope = "pane"
        self.claude_scope = "pane"
        self.choices = choices
        self.clauder_choices = clauder_choices
        self.provider_values = tuple(value for value, _ in choices)
        self.clauder_provider_values = tuple(value for value, _ in clauder_choices)
        self.claude_model_values = tuple(value for value, _ in CLAUDE_MODEL_CHOICES)
        self.ai_tool_values = tuple(value for value, _ in AI_TOOL_CHOICES)

    def compose(self) -> ComposeResult:
        yield Header()
        with TabbedContent(initial="provider-tab"):
            with TabPane("Codex Provider", id="provider-tab"):
                yield Static(id="provider-status", classes="status")
                yield RadioSet(
                    *(
                        RadioButton(label, value=value == self.scope, id=value)
                        for value, label in SCOPES
                    ),
                    id="scope",
                    compact=True,
                )
                yield OptionList(
                    *(Option(label, id=value) for value, label in self.choices),
                    id="providers",
                    classes="choices",
                )
            with TabPane("Claude Provider", id="clauder-tab"):
                yield Static(id="clauder-status", classes="status")
                yield RadioSet(
                    *(
                        RadioButton(
                            label,
                            value=value == self.clauder_scope,
                            id=f"clauder-{value}",
                        )
                        for value, label in SCOPES
                    ),
                    id="clauder-scope",
                    compact=True,
                )
                yield OptionList(
                    *(Option(label, id=value) for value, label in self.clauder_choices),
                    id="clauder-providers",
                    classes="choices",
                )
            with TabPane("Claude Model", id="claude-tab"):
                yield Static(id="claude-status", classes="status")
                yield RadioSet(
                    *(
                        RadioButton(
                            label,
                            value=value == self.claude_scope,
                            id=f"claude-{value}",
                        )
                        for value, label in SCOPES
                    ),
                    id="claude-scope",
                    compact=True,
                )
                yield OptionList(
                    *(Option(label, id=value) for value, label in CLAUDE_MODEL_CHOICES),
                    id="claude-models",
                    classes="choices",
                )
            with TabPane("AI Tool", id="ai-tool-tab"):
                yield Static(id="ai-tool-status", classes="status")
                yield OptionList(
                    *(Option(label, id=value) for value, label in AI_TOOL_CHOICES),
                    id="ai-tools",
                    classes="choices",
                )
        yield Footer()

    def on_mount(self) -> None:
        self.refresh_status()
        self.sync_highlight()
        self.query_one("#providers", OptionList).focus()
        self.set_interval(1, self.refresh_status)

    def values(self) -> tuple[str | None, str | None, str | None, str | None, str]:
        pane_value = read_pane_option(self.pane, PROVIDER_PANE_OPTION)
        session_value = read_variable(PROVIDER_VARIABLE, "-t", self.session)
        global_value = read_variable(PROVIDER_VARIABLE, "-g")
        shell_value = os.environ.get(PROVIDER_VARIABLE)
        effective = (
            pane_value or session_value or global_value or shell_value or "openai"
        )
        return pane_value, session_value, global_value, shell_value, effective

    def clauder_values(
        self,
    ) -> tuple[str | None, str | None, str | None, str | None, str, str]:
        # Mirrors _clauder_default_provider: pane, session, global, then the
        # shell's CLAUDER_PROVIDER from env.local. No built-in default --
        # clauder refuses to start without one.
        pane_value = read_pane_option(self.pane, CLAUDER_PROVIDER_PANE_OPTION)
        session_value = read_variable(CLAUDER_PROVIDER_VARIABLE, "-t", self.session)
        global_value = read_variable(CLAUDER_PROVIDER_VARIABLE, "-g")
        shell_value = os.environ.get(CLAUDER_PROVIDER_VARIABLE)
        effective = pane_value or session_value or global_value or shell_value or "<unset>"
        source = (
            "pane"
            if pane_value
            else "session"
            if session_value
            else "global"
            if global_value
            else "shell"
        )
        return pane_value, session_value, global_value, shell_value, effective, source

    def clauder_provider_model(self) -> str | None:
        # The effective provider file's top-level "model"; None when the
        # provider is unset/unknown or the file has none.
        provider = self.clauder_values()[4]
        path = CLAUDER_PROVIDER_DIR / f"{provider}.json"
        if provider not in self.clauder_provider_values or not path.is_file():
            return None
        return json.loads(path.read_text()).get("model") or None

    def claude_values(
        self,
    ) -> tuple[str | None, str | None, str | None, str | None, str | None, str, str]:
        # Mirrors clauder's resolution order: the launcher's TMUX_AI_MODEL
        # (explicit selection, wins outright), then pane option, session env,
        # global env, then the per-machine default from env.local.
        pane_value = read_pane_option(self.pane, CLAUDE_MODEL_PANE_OPTION)
        launcher_value = os.environ.get("TMUX_AI_MODEL")
        session_value = read_variable(CLAUDE_MODEL_VARIABLE, "-t", self.session)
        global_value = read_variable(CLAUDE_MODEL_VARIABLE, "-g")
        provider_value = self.clauder_provider_model()
        default_value = os.environ.get(CLAUDE_DEFAULT_VARIABLE)
        effective = (
            launcher_value
            or pane_value
            or session_value
            or global_value
            or provider_value
            or default_value
            or "<unset>"
        )
        source = (
            "launcher"
            if launcher_value
            else "pane"
            if pane_value
            else "session"
            if session_value
            else "global"
            if global_value
            else "provider file"
            if provider_value
            else "default"
        )
        return (
            pane_value,
            launcher_value,
            session_value,
            global_value,
            default_value,
            effective,
            source,
        )

    def refresh_status(self) -> None:
        pane_value, session_value, global_value, shell_value, effective = self.values()
        source = (
            "pane"
            if pane_value
            else "session"
            if session_value
            else "global"
            if global_value
            else "shell"
            if shell_value
            else "default"
        )
        unsupported = (
            f"\nUnsupported value: {effective} — choose a listed provider"
            if effective not in self.provider_values
            else ""
        )
        self.query_one("#provider-status", Static).update(
            f"Session: {self.session}    Pane: {self.pane}\n"
            f"Pane override: {pane_value or '<inherit>'}\n"
            f"Session override: {session_value or '<inherit>'}\n"
            f"Global value: {global_value or '<unset>'}\n"
            f"Effective: {effective} ({source}) — applies to the next codexr here\n"
            f"Apply to: {self.scope}"
            f"{unsupported}"
        )
        (
            clauder_pane,
            clauder_session,
            clauder_global,
            clauder_shell,
            clauder_effective,
            clauder_source,
        ) = self.clauder_values()
        unsupported_clauder = (
            f"\nUnsupported value: {clauder_effective} — no such file in {CLAUDER_PROVIDER_DIR}"
            if clauder_effective not in self.clauder_provider_values
            else ""
        )
        self.query_one("#clauder-status", Static).update(
            f"Session: {self.session}    Pane: {self.pane}\n"
            f"Pane override: {clauder_pane or '<inherit>'}\n"
            f"Session override: {clauder_session or '<inherit>'}\n"
            f"Global value: {clauder_global or '<unset>'}\n"
            f"Shell default ({CLAUDER_PROVIDER_VARIABLE} in env.local): {clauder_shell or '<unset>'}\n"
            f"Effective: {clauder_effective} ({clauder_source}) — applies to the next clauder here\n"
            f"Apply to: {self.clauder_scope}"
            f"{unsupported_clauder}"
        )
        (
            claude_pane,
            claude_launcher,
            claude_session,
            claude_global,
            claude_default,
            claude_effective,
            claude_source,
        ) = self.claude_values()
        # The launcher value is this shell's environment, not a tmux scope:
        # llm-conf cannot set or clear it, so it is shown as a warning only
        # when present rather than as a fifth scope row.
        launcher_warning = (
            f"\nWARNING: this shell was launched with TMUX_AI_MODEL={claude_launcher};"
            " it overrides every setting above (unset it in the shell to change)"
            if claude_launcher
            else ""
        )
        self.query_one("#claude-status", Static).update(
            f"Session: {self.session}    Pane: {self.pane}\n"
            f"Pane override: {claude_pane or '<inherit>'}\n"
            f"Session override: {claude_session or '<inherit>'}\n"
            f"Global value: {claude_global or '<unset>'}\n"
            f"Default ({CLAUDE_DEFAULT_VARIABLE} in env.local): {claude_default or '<unset>'}\n"
            f"Effective: {claude_effective} ({claude_source}) — applies to the next clauder here\n"
            f"Apply to: {self.claude_scope}\n"
            "Model names are gateway-specific; with no override clauder uses the\n"
            "provider file's \"model\" before the env.local default."
            f"{launcher_warning}"
        )
        ai_tool = read_variable(AI_TOOL_VARIABLE, "-g")
        unsupported_ai_tool = (
            f"\nUnsupported value: {ai_tool} — choose a listed tool"
            if ai_tool and ai_tool not in self.ai_tool_values
            else ""
        )
        self.query_one("#ai-tool-status", Static).update(
            f"Global {AI_TOOL_VARIABLE}: {ai_tool or '<unset>'}\n"
            "Applies to newly launched TMA agents"
            f"{unsupported_ai_tool}"
        )

    def sync_highlight(self) -> None:
        pane_value, session_value, global_value, _, _ = self.values()
        target = (
            {"pane": pane_value, "session": session_value}.get(self.scope, global_value)
            or "inherit"
        )
        self.query_one("#providers", OptionList).highlighted = (
            self.provider_values.index(target)
            if target in self.provider_values
            else None
        )
        clauder_pane, clauder_session, clauder_global, _, _, _ = self.clauder_values()
        clauder_target = (
            {"pane": clauder_pane, "session": clauder_session}.get(
                self.clauder_scope, clauder_global
            )
            or "inherit"
        )
        self.query_one("#clauder-providers", OptionList).highlighted = (
            self.clauder_provider_values.index(clauder_target)
            if clauder_target in self.clauder_provider_values
            else None
        )
        claude_pane, _, claude_session, claude_global, _, _, _ = self.claude_values()
        claude_target = (
            {"pane": claude_pane, "session": claude_session}.get(
                self.claude_scope, claude_global
            )
            or "inherit"
        )
        self.query_one("#claude-models", OptionList).highlighted = (
            self.claude_model_values.index(claude_target)
            if claude_target in self.claude_model_values
            else None
        )
        ai_tool = read_variable(AI_TOOL_VARIABLE, "-g")
        self.query_one("#ai-tools", OptionList).highlighted = (
            self.ai_tool_values.index(ai_tool)
            if ai_tool in self.ai_tool_values
            else None
        )

    def apply(self, value: str) -> None:
        try:
            set_provider(self.scope, self.session, self.pane, value)
        except ToolError as error:
            self.notify(str(error), severity="error")
            return
        self.refresh_status()
        self.sync_highlight()
        name = PROVIDER_PANE_OPTION if self.scope == "pane" else PROVIDER_VARIABLE
        self.notify(f"{self.scope} {name} → {value}")

    def apply_clauder(self, value: str) -> None:
        try:
            set_clauder_provider(self.clauder_scope, self.session, self.pane, value)
        except ToolError as error:
            self.notify(str(error), severity="error")
            return
        self.refresh_status()
        self.sync_highlight()
        name = (
            CLAUDER_PROVIDER_PANE_OPTION
            if self.clauder_scope == "pane"
            else CLAUDER_PROVIDER_VARIABLE
        )
        self.notify(f"{self.clauder_scope} {name} → {value}")

    def apply_claude(self, value: str) -> None:
        try:
            set_claude_model(self.claude_scope, self.session, self.pane, value)
        except ToolError as error:
            self.notify(str(error), severity="error")
            return
        self.refresh_status()
        self.sync_highlight()
        name = (
            CLAUDE_MODEL_PANE_OPTION
            if self.claude_scope == "pane"
            else CLAUDE_MODEL_VARIABLE
        )
        self.notify(f"{self.claude_scope} {name} → {value}")

    def apply_ai_tool(self, value: str) -> None:
        try:
            set_ai_tool(value)
        except ToolError as error:
            self.notify(str(error), severity="error")
            return
        self.refresh_status()
        self.sync_highlight()
        self.notify(f"global {AI_TOOL_VARIABLE} → {value}")

    OPTION_LISTS: ClassVar[dict[str, str]] = {
        "provider-tab": "#providers",
        "clauder-tab": "#clauder-providers",
        "claude-tab": "#claude-models",
        "ai-tool-tab": "#ai-tools",
    }

    def action_apply(self) -> None:
        active_tab = self.query_one(TabbedContent).active
        options = self.query_one(self.OPTION_LISTS[active_tab], OptionList)
        if options.highlighted is not None:
            value = options.get_option_at_index(options.highlighted).id
            if active_tab == "provider-tab":
                self.apply(value)
            elif active_tab == "clauder-tab":
                self.apply_clauder(value)
            elif active_tab == "claude-tab":
                self.apply_claude(value)
            else:
                self.apply_ai_tool(value)

    def action_show_tab(self, tab_id: str) -> None:
        self.query_one(TabbedContent).active = tab_id
        self.query_one(self.OPTION_LISTS[tab_id], OptionList).focus()

    def action_refresh(self) -> None:
        self.refresh_status()
        self.sync_highlight()

    def on_radio_set_changed(self, event: RadioSet.Changed) -> None:
        if event.radio_set.id == "clauder-scope":
            self.clauder_scope = (event.pressed.id or "clauder-pane").removeprefix(
                "clauder-"
            )
        elif event.radio_set.id == "claude-scope":
            self.claude_scope = (event.pressed.id or "claude-pane").removeprefix(
                "claude-"
            )
        else:
            self.scope = event.pressed.id or "pane"
        self.refresh_status()
        self.sync_highlight()

    def on_option_list_option_selected(self, event: OptionList.OptionSelected) -> None:
        if event.option_list.id == "providers":
            self.apply(event.option.id)
        elif event.option_list.id == "clauder-providers":
            self.apply_clauder(event.option.id)
        elif event.option_list.id == "claude-models":
            self.apply_claude(event.option.id)
        else:
            self.apply_ai_tool(event.option.id)


def main() -> int:
    if sys.argv[1:] in (["-h"], ["--help"]):
        print(
            "llm-conf: configure the Codex provider, the Claude provider and"
            " model, and the global tmux AI tool"
        )
        return 0
    pane = current_pane()
    ProviderApp(
        pane, current_session(pane), provider_choices(), clauder_provider_choices()
    ).run()
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except ToolError as error:
        print(f"llm-conf: {error}", file=sys.stderr)
        raise SystemExit(1) from error
