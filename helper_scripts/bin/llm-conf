#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "textual>=8.2,<9",
# ]
# ///

from __future__ import annotations

import os
import re
import subprocess
import sys
from pathlib import Path
from typing import ClassVar

import tomllib
from textual.app import App, ComposeResult
from textual.widgets import (
    Footer,
    Header,
    OptionList,
    RadioButton,
    RadioSet,
    Static,
    TabbedContent,
    TabPane,
)
from textual.widgets.option_list import Option

PROVIDER_VARIABLE = "CODEXR_PROVIDER"
AI_TOOL_VARIABLE = "TMUX_AI_TOOL"
STATIC_CHOICES = (
    ("lb8121", "lb8121 — shared 8121 endpoint (default)"),
    ("openai", "openai — official OpenAI login"),
    ("xyz", "xyz — XYZ normally, Azure inside Obsidian"),
)
SCOPES = (
    ("session", "Current session"),
    ("global", "Global tmux server"),
)
AI_TOOL_CHOICES = (
    ("codex", "codex — launch Codex with codexr"),
    ("gemini", "gemini — launch Gemini"),
    ("claude", "claude — launch Claude Code with clauder"),
)


class ToolError(RuntimeError):
    pass


def provider_choices() -> tuple[tuple[str, str], ...]:
    config_path = (
        Path(os.environ.get("CODEX_HOME", Path.home() / ".codex")) / "config.toml"
    )
    configured: list[tuple[str, str]] = []

    if config_path.exists():
        try:
            with config_path.open("rb") as config_file:
                config = tomllib.load(config_file)
        except (OSError, tomllib.TOMLDecodeError) as error:
            raise ToolError(f"cannot read {config_path}: {error}") from error

        providers = config.get("model_providers", {})
        if not isinstance(providers, dict):
            raise ToolError(f"model_providers in {config_path} must be a table")
        for provider_id, provider in providers.items():
            if not re.fullmatch(r"[A-Za-z0-9_-]+", provider_id):
                raise ToolError(
                    f"unsupported provider id in {config_path}: {provider_id!r}"
                )
            if not isinstance(provider, dict):
                raise ToolError(
                    f"model_providers.{provider_id} in {config_path} must be a table"
                )
            display_name = provider.get("name") or provider_id
            configured.append((provider_id, f"{provider_id} — {display_name} (config)"))

    choices = list(STATIC_CHOICES)
    known = {value for value, _ in choices}
    choices.extend(choice for choice in configured if choice[0] not in known)
    choices.append(("inherit", "inherit — remove the selected-scope override"))
    return tuple(choices)


def run_tmux(*args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        ["tmux", *args], capture_output=True, text=True, check=False
    )
    if check and result.returncode:
        raise ToolError(
            result.stderr.strip() or f"tmux exited with {result.returncode}"
        )
    return result


def current_session() -> str:
    pane = os.environ.get("TMUX_PANE")
    if not os.environ.get("TMUX") or not pane:
        raise ToolError("must run inside a tmux pane")
    return run_tmux("display-message", "-p", "-t", pane, "#S").stdout.strip()


def read_variable(variable: str, *scope: str) -> str | None:
    result = run_tmux("show-environment", *scope, variable, check=False)
    line = result.stdout.strip()
    if line.startswith(f"{variable}="):
        return line.split("=", 1)[1]
    if result.returncode and "unknown variable" not in result.stderr:
        raise ToolError(result.stderr.strip())
    return None


def set_provider(scope: str, session: str, value: str) -> None:
    target = ["-g"] if scope == "global" else ["-t", session]
    if value == "inherit":
        run_tmux("set-environment", *target, "-r", PROVIDER_VARIABLE)
    else:
        run_tmux("set-environment", *target, PROVIDER_VARIABLE, value)


def set_ai_tool(value: str) -> None:
    run_tmux("set-environment", "-g", AI_TOOL_VARIABLE, value)


class ProviderApp(App[None]):
    TITLE = "Tmux AI settings"
    CSS = """
    TabbedContent { height: 1fr; }
    .status { margin: 1 2; padding: 1 2; border: round $accent; }
    #scope { margin: 0 2 1 2; height: 3; layout: horizontal; border: round $secondary; }
    #scope RadioButton { width: 1fr; }
    .choices { margin: 0 2 1 2; height: auto; border: round $primary; }
    """
    BINDINGS: ClassVar[list[tuple[str, str, str]]] = [
        ("right", "apply", "Apply"),
        ("1", "show_tab('provider-tab')", "Provider"),
        ("2", "show_tab('ai-tool-tab')", "AI tool"),
        ("r", "refresh", "Refresh"),
        ("left,escape,q", "quit", "Quit"),
    ]

    def __init__(self, session: str, choices: tuple[tuple[str, str], ...]) -> None:
        super().__init__()
        self.session = session
        self.scope = "session"
        self.choices = choices
        self.provider_values = tuple(value for value, _ in choices)
        self.ai_tool_values = tuple(value for value, _ in AI_TOOL_CHOICES)

    def compose(self) -> ComposeResult:
        yield Header()
        with TabbedContent(initial="provider-tab"):
            with TabPane("Codex Provider", id="provider-tab"):
                yield Static(id="provider-status", classes="status")
                yield RadioSet(
                    *(
                        RadioButton(label, value=value == self.scope, id=value)
                        for value, label in SCOPES
                    ),
                    id="scope",
                    compact=True,
                )
                yield OptionList(
                    *(Option(label, id=value) for value, label in self.choices),
                    id="providers",
                    classes="choices",
                )
            with TabPane("AI Tool", id="ai-tool-tab"):
                yield Static(id="ai-tool-status", classes="status")
                yield OptionList(
                    *(Option(label, id=value) for value, label in AI_TOOL_CHOICES),
                    id="ai-tools",
                    classes="choices",
                )
        yield Footer()

    def on_mount(self) -> None:
        self.refresh_status()
        self.sync_highlight()
        self.query_one("#providers", OptionList).focus()
        self.set_interval(1, self.refresh_status)

    def values(self) -> tuple[str | None, str | None, str | None, str]:
        session_value = read_variable(PROVIDER_VARIABLE, "-t", self.session)
        global_value = read_variable(PROVIDER_VARIABLE, "-g")
        shell_value = os.environ.get(PROVIDER_VARIABLE)
        effective = session_value or global_value or shell_value or "lb8121"
        return session_value, global_value, shell_value, effective

    def refresh_status(self) -> None:
        session_value, global_value, shell_value, effective = self.values()
        source = (
            "session"
            if session_value
            else "global"
            if global_value
            else "shell"
            if shell_value
            else "default"
        )
        unsupported = (
            f"\nUnsupported value: {effective} — choose a listed provider"
            if effective not in self.provider_values
            else ""
        )
        self.query_one("#provider-status", Static).update(
            f"Session: {self.session}\n"
            f"Session override: {session_value or '<inherit>'}\n"
            f"Global value: {global_value or '<unset>'}\n"
            f"Effective: {effective} ({source})\n"
            f"Apply to: {self.scope}"
            f"{unsupported}"
        )
        ai_tool = read_variable(AI_TOOL_VARIABLE, "-g")
        unsupported_ai_tool = (
            f"\nUnsupported value: {ai_tool} — choose a listed tool"
            if ai_tool and ai_tool not in self.ai_tool_values
            else ""
        )
        self.query_one("#ai-tool-status", Static).update(
            f"Global {AI_TOOL_VARIABLE}: {ai_tool or '<unset>'}\n"
            "Applies to newly launched TMA agents"
            f"{unsupported_ai_tool}"
        )

    def sync_highlight(self) -> None:
        session_value, global_value, _, _ = self.values()
        target = (
            session_value if self.scope == "session" else global_value
        ) or "inherit"
        self.query_one("#providers", OptionList).highlighted = (
            self.provider_values.index(target)
            if target in self.provider_values
            else None
        )
        ai_tool = read_variable(AI_TOOL_VARIABLE, "-g")
        self.query_one("#ai-tools", OptionList).highlighted = (
            self.ai_tool_values.index(ai_tool)
            if ai_tool in self.ai_tool_values
            else None
        )

    def apply(self, value: str) -> None:
        try:
            set_provider(self.scope, self.session, value)
        except ToolError as error:
            self.notify(str(error), severity="error")
            return
        self.refresh_status()
        self.sync_highlight()
        self.notify(f"{self.scope} {PROVIDER_VARIABLE} → {value}")

    def apply_ai_tool(self, value: str) -> None:
        try:
            set_ai_tool(value)
        except ToolError as error:
            self.notify(str(error), severity="error")
            return
        self.refresh_status()
        self.sync_highlight()
        self.notify(f"global {AI_TOOL_VARIABLE} → {value}")

    def action_apply(self) -> None:
        active_tab = self.query_one(TabbedContent).active
        options = self.query_one(
            "#providers" if active_tab == "provider-tab" else "#ai-tools", OptionList
        )
        if options.highlighted is not None:
            value = options.get_option_at_index(options.highlighted).id
            if active_tab == "provider-tab":
                self.apply(value)
            else:
                self.apply_ai_tool(value)

    def action_show_tab(self, tab_id: str) -> None:
        self.query_one(TabbedContent).active = tab_id
        self.query_one(
            "#providers" if tab_id == "provider-tab" else "#ai-tools", OptionList
        ).focus()

    def action_refresh(self) -> None:
        self.refresh_status()
        self.sync_highlight()

    def on_radio_set_changed(self, event: RadioSet.Changed) -> None:
        self.scope = event.pressed.id or "session"
        self.refresh_status()
        self.sync_highlight()

    def on_option_list_option_selected(self, event: OptionList.OptionSelected) -> None:
        if event.option_list.id == "providers":
            self.apply(event.option.id)
        else:
            self.apply_ai_tool(event.option.id)


def main() -> int:
    if sys.argv[1:] in (["-h"], ["--help"]):
        print("llm-conf: configure Codex provider and the global tmux AI tool")
        return 0
    ProviderApp(current_session(), provider_choices()).run()
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except ToolError as error:
        print(f"llm-conf: {error}", file=sys.stderr)
        raise SystemExit(1) from error
