SESSION_COOKIE = "msg_bridge_session"
SESSION_AGE = 30 * 24 * 60 * 60
app = typer.Typer(add_completion=False, help="Tiny sender / bridge / receiver for tmux message input")


def web_password(path: Path) -> str:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    if not path.exists():
        with open(path, "x", opener=lambda name, flags: os.open(name, flags, 0o600)) as file:
            file.write(secrets.token_urlsafe(24) + "\n")
    password = path.read_text().strip()
    if not password:
        raise ValueError(f"Web password file is empty: {path}")
    return password


def web_app(
    password: str, forward: Callable[[str], Awaitable[int]],
    history: Callable[[], list[dict]],
) -> web.Application:
    response_headers = {
        "Cache-Control": "no-store",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "no-referrer",
        "Content-Security-Policy": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'",
    }

    @web.middleware
    async def headers(request, handler):
        try:
            response = await handler(request)
        except web.HTTPException as error:
            error.headers.update(response_headers)
            raise
        response.headers.update(response_headers)
        return response

    async def page(request):
        return web.Response(text=WEB_PAGE, content_type="text/html")

    async def redirect(request):
        raise web.HTTPPermanentRedirect("/send/")

    async def asset(request):
        name = request.match_info["name"]
        content_type = "text/javascript" if name == "app.js" else "text/css"
        return web.Response(text={"app.js": WEB_SCRIPT, "style.css": WEB_STYLE}[name], content_type=content_type)

    def signature(payload: str) -> str:
        return hmac.new(password.encode(), payload.encode(), "sha256").hexdigest()

    def require_session(request):
        token = request.cookies.get(SESSION_COOKIE, "")
        try:
            expires, nonce, signed = token.split(".")
            valid_until = int(expires)
        except ValueError:
            raise web.HTTPUnauthorized(text="请先登录")
        if valid_until <= time.time() or not secrets.compare_digest(signed.encode(), signature(f"{expires}.{nonce}").encode()):
            raise web.HTTPUnauthorized(text="登录已过期，请重新登录")

    async def json_body(request):
        if request.content_type != "application/json":
            raise web.HTTPUnsupportedMediaType(text="请求必须使用 JSON")
        try:
            payload = await request.json()
        except (json.JSONDecodeError, UnicodeDecodeError):
            raise web.HTTPBadRequest(text="JSON 格式错误")
        if not isinstance(payload, dict):
            raise web.HTTPBadRequest(text="JSON 必须为对象")
        return payload

    async def login(request):
        payload = await json_body(request)
        provided = payload.get("password")
        if not isinstance(provided, str) or not secrets.compare_digest(provided.encode(), password.encode()):
            raise web.HTTPUnauthorized(text="密码错误")
        token = f"{int(time.time()) + SESSION_AGE}.{secrets.token_urlsafe(24)}"
        response = web.json_response({"authenticated": True})
        response.set_cookie(SESSION_COOKIE, f"{token}.{signature(token)}", max_age=SESSION_AGE,
                            path="/send/", secure=True, httponly=True, samesite="Strict")
        return response

    async def session(request):
        require_session(request)
        return web.json_response({"authenticated": True})

    async def logout(request):
        await json_body(request)
        response = web.json_response({"authenticated": False})
        response.del_cookie(SESSION_COOKIE, path="/send/")
        return response

    async def send(request):
        require_session(request)
        payload = await json_body(request)
        message = payload.get("message")
        if not isinstance(message, str) or not message.strip():
            raise web.HTTPBadRequest(text="请输入消息")
        if message == RECEIVER:
            raise web.HTTPBadRequest(text="不能发送 bridge 的保留连接标记")
        count = await forward(message)
        return web.json_response({"receivers": count})

    async def recent_messages(request):
        require_session(request)
        return web.json_response({"messages": history()})

    application = web.Application(middlewares=[headers], client_max_size=1024 * 1024)
    application.router.add_get("/send", redirect)
    application.router.add_get("/send/", page)
    application.router.add_get("/send/{name:app\\.js|style\\.css}", asset)
    application.router.add_post("/send/api/login", login)
    application.router.add_get("/send/api/session", session)
    application.router.add_post("/send/api/logout", logout)
    application.router.add_get("/send/api/messages", recent_messages)
    application.router.add_post("/send/api/messages", send)
    return application


async def bridge_loop(
    host: str, port: int, db_path: Path, *, web_host: str = DEFAULT_HOST,
    web_port: int | None = None, password_file: Path = DEFAULT_PASSWORD_FILE,
    web_cert: Path | None = None, web_key: Path | None = None,
) -> None:
    tls = None
    if bool(web_cert) != bool(web_key):
        raise ValueError("--web-cert and --web-key must be provided together")
    if web_cert and web_port is None:
        raise ValueError("--web-cert requires --web-port")
    if web_cert:
        tls = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        tls.load_cert_chain(web_cert, web_key)
    if web_port is not None and tls is None and web_host not in {"127.0.0.1", "::1", "localhost"}:
        raise ValueError("Plain HTTP must bind to loopback; use --web-cert/--web-key for public HTTPS")
    password = web_password(password_file) if web_port is not None else None
    receivers: set[websockets.ServerConnection] = set()
    db_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    db_path.touch(exist_ok=True, mode=0o600)

    with closing(sqlite3.connect(db_path)) as db:
        db.execute("""CREATE TABLE IF NOT EXISTS messages (
            id INTEGER PRIMARY KEY,
            received_at TEXT NOT NULL,
            content TEXT NOT NULL,
            char_count INTEGER NOT NULL,
            byte_count INTEGER NOT NULL
        )""")
        db.execute("CREATE INDEX IF NOT EXISTS messages_received_at ON messages(received_at)")
        db.commit()

        async def forward(msg: str) -> int:
            if not isinstance(msg, str):
                raise TypeError("msg-bridge only accepts text messages")
            db.execute(
                "INSERT INTO messages (received_at, content, char_count, byte_count) VALUES (?, ?, ?, ?)",
                (datetime.now(timezone.utc).isoformat(timespec="milliseconds"), msg, len(msg), len(msg.encode("utf-8"))),
            )
            db.commit()
            return await broadcast(receivers, msg)

        def history() -> list[dict]:
            rows = db.execute(
                "SELECT id, received_at, content FROM messages ORDER BY id DESC LIMIT 50"
            ).fetchall()
            return [{"id": row[0], "received_at": row[1], "content": row[2]} for row in rows]

        async def handle(ws: websockets.ServerConnection) -> None:
            first = await ws.recv()
            if first == RECEIVER:
                receivers.add(ws)
                try:
                    await ws.wait_closed()
                finally:
                    receivers.discard(ws)
                return
            await forward(first)
            async for msg in ws:
                await forward(msg)

        async with websockets.serve(handle, host, port):
            print(f"msg-bridge b listening on ws://{host}:{port}; storing messages in {db_path}")
            runner = web.AppRunner(web_app(password, forward, history)) if password is not None else None
            try:
                if runner:
                    await runner.setup()
                    await web.TCPSite(runner, web_host, web_port, ssl_context=tls).start()
                    print(f"Web sender: {'https' if tls else 'http'}://{web_host}:{web_port}/send/; password file: {password_file}", flush=True)
                await asyncio.Future()
            finally:
                if runner:
                    await runner.cleanup()


async def broadcast(receivers: set[websockets.ServerConnection], msg: str) -> int:
    dead = []
    delivered = 0
    for ws in tuple(receivers):
        try:
            await ws.send(msg)
            delivered += 1
        except websockets.ConnectionClosed:
            dead.append(ws)
    for ws in dead:
        receivers.discard(ws)
    return delivered


def parse_endpoint(host: str, port: int) -> tuple[str, int]:
    if host.startswith("ws://"):
        host = host.removeprefix("ws://")
    if host.startswith("wss://"):
        raise SystemExit("wss:// is not supported by this tiny bridge")
    if ":" in host and host.rsplit(":", 1)[1].isdigit():
        host, port_text = host.rsplit(":", 1)
        port = int(port_text)
    return host, port


def ws_url(host: str, port: int) -> str:
    if ":" in host and not host.startswith("["):
        host = f"[{host}]"
    return f"ws://{host}:{port}"


def client_endpoint(host: str, port: int) -> tuple[str, int, str]:
    raw_host, port = parse_endpoint(host, port)
    infos = socket.getaddrinfo(raw_host, port, type=socket.SOCK_STREAM)
    ipv4 = [info for info in infos if info[0] == socket.AF_INET]
    resolved_host = (ipv4 or infos)[0][4][0]
    if resolved_host != raw_host:
        print(f"msg-bridge endpoint: {raw_host}:{port} -> {resolved_host}:{port}", flush=True)
    else:
        print(f"msg-bridge endpoint: {resolved_host}:{port}", flush=True)
    return resolved_host, port, ws_url(resolved_host, port)


async def send_loop(host: str, port: int, batch: bool) -> None:
    _, _, url = client_endpoint(host, port)
    pending: list[str] = []
    deadline = 0.0
    loop = asyncio.get_running_loop()
    session = None
    if sys.stdin.isatty():
        from prompt_toolkit.key_binding import KeyBindings
        from prompt_toolkit import PromptSession
        from prompt_toolkit.history import InMemoryHistory

        bindings = KeyBindings()

        @bindings.add("c-g")
        def _(event) -> None:
            event.app.current_buffer.open_in_editor()

        session = PromptSession(history=InMemoryHistory(), key_bindings=bindings)

        def on_text_changed(_buffer) -> None:
            nonlocal deadline
            if pending:
                deadline = loop.time() + BATCH_DELAY

        session.default_buffer.on_text_changed += on_text_changed

    async def read_message() -> str:
        if session:
            return await session.prompt_async(lambda: "[waiting] " if pending else "> ")
        return await asyncio.to_thread(input, "> ")

    def update_prompt() -> None:
        if session:
            session.app.invalidate()

    ws = await websockets.connect(url, open_timeout=60)

    async def send_message(msg: str) -> None:
        nonlocal ws
        try:
            await ws.send(msg)
        except websockets.ConnectionClosed:
            print("connection lost; reconnecting and retrying this message...", flush=True)
            ws = await websockets.connect(url, open_timeout=60)
            await ws.send(msg)

    async def flush_pending() -> None:
        await send_message(" ".join(pending))
        pending.clear()
        update_prompt()

    prompt_task = asyncio.create_task(read_message())
    try:
        print(f"type text, Ctrl-G edits in $EDITOR, Enter {'queues' if batch else 'sends'}; Ctrl-D exits")
        while True:
            try:
                if pending:
                    done, _ = await asyncio.wait({prompt_task}, timeout=max(0, deadline - loop.time()))
                    if not done:
                        if session and session.default_buffer.text:
                            deadline = loop.time() + BATCH_DELAY
                        elif loop.time() >= deadline:
                            await flush_pending()
                        continue
                msg = await prompt_task
            except EOFError:
                if pending:
                    await flush_pending()
                return
            prompt_task = asyncio.create_task(read_message())
            if not msg.strip():
                if pending:
                    deadline = loop.time() + BATCH_DELAY
                continue
            if batch:
                pending.append(msg)
                deadline = loop.time() + BATCH_DELAY
                update_prompt()
            else:
                await send_message(msg)
    finally:
        prompt_task.cancel()
        await ws.close()


def tmux(*args: str) -> str:
    return subprocess.check_output(["tmux", *args], text=True).strip()


def active_client_tty() -> str:
    clients = tmux("list-clients", "-F", "#{client_activity} #{client_tty}").splitlines()
    if not clients:
        raise SystemExit("msg-bridge r requires an attached tmux client unless --session is set")
    _activity, tty = max((line.split(maxsplit=1) for line in clients), key=lambda item: int(item[0]))
    return tty


def active_pane(session: str | None) -> str:
    if session:
        return tmux("display-message", "-p", "-t", f"{session}:", "#{pane_id}")
    if not os.environ.get("TMUX"):
        raise SystemExit("msg-bridge r must run inside tmux unless --session is set")
    return tmux("display-message", "-p", "-t", active_client_tty(), "#{pane_id}")


def inject(msg: str, session: str | None, enter_delay: float) -> None:
    pane = active_pane(session)
    buf = f"msg-bridge-{os.getpid()}-{time.time_ns()}"
    subprocess.run(["tmux", "set-buffer", "-b", buf, "--", msg], check=True)
    try:
        subprocess.run(["tmux", "paste-buffer", "-b", buf, "-t", pane], check=True)
        if enter_delay:
            time.sleep(enter_delay)
        subprocess.run(["tmux", "send-keys", "-t", pane, "Enter"], check=True)
    finally:
        subprocess.run(["tmux", "delete-buffer", "-b", buf], check=False)


async def receive_loop(host: str, port: int, session: str | None, enter_delay: float) -> None:
    _, _, url = client_endpoint(host, port)
    while True:
        try:
            async with websockets.connect(url, open_timeout=60) as ws:
                await ws.send(RECEIVER)
                async for msg in ws:
                    inject(msg, session, enter_delay)
        except (OSError, websockets.ConnectionClosed):
            await asyncio.sleep(1)


@app.command("b", help="bridge messages from senders to receivers")
def b(
    host: Annotated[str, typer.Option("--host", "-H")] = "0.0.0.0",
    port: Annotated[int, typer.Option("--port", "-P")] = DEFAULT_PORT,
    db_path: Annotated[Path, typer.Option("--db", help="SQLite message archive path")] = DEFAULT_DB,
    web_port: Annotated[int | None, typer.Option(help="Enable the /send/ web page on this port")] = None,
    web_host: Annotated[str, typer.Option(help="Web listener bind address")] = DEFAULT_HOST,
    password_file: Annotated[Path, typer.Option(help="Web password file; generated on first start")] = DEFAULT_PASSWORD_FILE,
    web_cert: Annotated[Path | None, typer.Option(help="HTTPS certificate PEM")] = None,
    web_key: Annotated[Path | None, typer.Option(help="HTTPS private key PEM")] = None,
) -> None:
    host, port = parse_endpoint(host, port)
    asyncio.run(bridge_loop(host, port, db_path, web_host=web_host, web_port=web_port,
                            password_file=password_file, web_cert=web_cert, web_key=web_key))


@app.command("stats", help="show total and recent daily message counts")
def stats(
    db_path: Annotated[Path, typer.Option("--db", help="SQLite message archive path")] = DEFAULT_DB,
) -> None:
    if not db_path.is_file():
        raise SystemExit(f"msg-bridge database not found: {db_path}")
    with closing(sqlite3.connect(f"{db_path.resolve().as_uri()}?mode=ro", uri=True)) as db:
        total = db.execute("SELECT COUNT(*) FROM messages").fetchone()[0]
        print(f"total: {total}")
        for day, count in db.execute("""
            SELECT date(received_at, 'localtime'), COUNT(*)
            FROM messages
            GROUP BY date(received_at, 'localtime')
            ORDER BY date(received_at, 'localtime') DESC
            LIMIT 30
        """):
            print(f"{day}: {count}")


@app.command("s", help="send one-line messages after 500 ms of empty input by default")
def s(
    host: Annotated[str, typer.Option("--host", "-H")] = DEFAULT_HOST,
    port: Annotated[int, typer.Option("--port", "-P")] = DEFAULT_PORT,
    batch: Annotated[bool, typer.Option("--batch/--no-batch", help="Join messages after 500 ms of empty input")] = True,
) -> None:
    asyncio.run(send_loop(host, port, batch))


@app.command("r", help="receive messages and inject into tmux")
def r(
    host: Annotated[str, typer.Option("--host", "-H")] = DEFAULT_HOST,
    port: Annotated[int, typer.Option("--port", "-P")] = DEFAULT_PORT,
    session: Annotated[str | None, typer.Option("--session")] = None,
    enter_delay: Annotated[float, typer.Option("--enter-delay")] = 0.2,
) -> None:
    asyncio.run(receive_loop(host, port, session, enter_delay))


if __name__ == "__main__":
    try:
        app()
    except KeyboardInterrupt:
        sys.exit(130)
