WEB_SCRIPT = r"""const form = document.querySelector('#sender');
const login = document.querySelector('#login');
const account = document.querySelector('#account');
const logout = document.querySelector('#logout');
const password = document.querySelector('#password');
const message = document.querySelector('#message');
const button = form.querySelector('button');
const loginButton = login.querySelector('button');
const status = document.querySelector('#status');
const workspace = document.querySelector('#workspace');
const historyList = document.querySelector('#history-list');
const historyStatus = document.querySelector('#history-status');
const refreshHistory = document.querySelector('#refresh-history');
let signedIn = false;

function showSession(authenticated) {
  signedIn = authenticated;
  login.hidden = authenticated;
  form.hidden = !authenticated;
  workspace.hidden = !authenticated;
  account.hidden = !authenticated;
  if (!authenticated) historyList.replaceChildren();
  (authenticated ? message : password).focus();
}

async function request(path, payload) {
  const response = await fetch(`./api/${path}`, {
    method: payload === undefined ? 'GET' : 'POST',
    credentials: 'same-origin',
    headers: payload === undefined ? {} : { 'Content-Type': 'application/json' },
    body: payload === undefined ? undefined : JSON.stringify(payload),
    signal: AbortSignal.timeout(15000),
  });
  if (!response.ok) {
    const error = new Error(await response.text());
    error.status = response.status;
    throw error;
  }
  return response.json();
}

function showError(error, sending = false) {
  status.dataset.error = 'true';
  status.textContent = error instanceof TypeError || error.name === 'TimeoutError'
    ? (sending ? '连接中断或超时，无法确认是否送达。内容已保留，重发前请先检查接收端。' : '连接失败，请检查网络后重试。')
    : error.message;
}

async function loadHistory() {
  refreshHistory.disabled = true;
  historyStatus.dataset.error = 'false';
  historyStatus.textContent = '正在加载…';
  try {
    const result = await request('messages');
    if (!signedIn) return;
    const items = result.messages.map((entry) => {
      const item = document.createElement('button');
      item.type = 'button';
      item.className = 'history-item';
      item.disabled = button.disabled;
      item.title = '点击立即重发这条消息';
      const time = document.createElement('time');
      time.dateTime = entry.received_at;
      time.textContent = new Date(entry.received_at).toLocaleString('zh-CN', { hour12: false });
      const content = document.createElement('span');
      content.className = 'history-content';
      content.textContent = entry.content;
      item.append(time, content);
      item.addEventListener('click', () => sendContent(entry.content, false));
      return item;
    });
    historyList.replaceChildren(...items);
    historyStatus.textContent = items.length ? '' : '还没有历史消息。';
  } catch (error) {
    if (error.status === 401) showSession(false);
    historyStatus.dataset.error = 'true';
    historyStatus.textContent = '历史消息加载失败，请点击刷新重试。';
    if (error.status === 401) showError(error);
  } finally {
    refreshHistory.disabled = button.disabled;
  }
}
refreshHistory.addEventListener('click', loadHistory);

login.addEventListener('submit', async (event) => {
  event.preventDefault();
  if (loginButton.disabled) return;
  loginButton.disabled = true;
  status.textContent = '正在登录…';
  status.dataset.error = 'false';
  try {
    await request('login', { password: password.value });
    password.value = '';
    showSession(true);
    status.textContent = '';
    await loadHistory();
  } catch (error) {
    showError(error);
  } finally {
    loginButton.disabled = false;
  }
});

logout.addEventListener('click', async () => {
  if (logout.disabled) return;
  logout.disabled = true;
  try {
    await request('logout', {});
    showSession(false);
    status.dataset.error = 'false';
    status.textContent = '已退出登录。';
  } catch (error) {
    showError(error);
  } finally {
    logout.disabled = false;
  }
});

async function sendContent(content, clearDraft) {
  if (button.disabled) return;
  if (!content.trim()) {
    showError(new Error('请输入消息。'));
    message.focus();
    return;
  }
  button.disabled = true;
  logout.disabled = true;
  refreshHistory.disabled = true;
  historyList.querySelectorAll('button').forEach((item) => { item.disabled = true; });
  message.readOnly = true;
  status.dataset.error = 'false';
  status.textContent = '正在发送…';
  try {
    const result = await request('messages', { message: content });
    status.textContent = result.receivers > 0
      ? `已发送到 ${result.receivers} 个接收端。`
      : '已存档，但没有接收端在线；这条消息不会自动补发。';
    if (clearDraft) message.value = '';
    await loadHistory();
  } catch (error) {
    if (error.status === 401) showSession(false);
    showError(error, true);
  } finally {
    button.disabled = false;
    logout.disabled = false;
    refreshHistory.disabled = false;
    historyList.querySelectorAll('button').forEach((item) => { item.disabled = false; });
    message.readOnly = false;
    if (!form.hidden) message.focus();
  }
}

form.addEventListener('submit', async (event) => {
  event.preventDefault();
  await sendContent(message.value, true);
});

message.addEventListener('keydown', (event) => {
  if ((event.ctrlKey || event.metaKey) && event.key === 'Enter' && !event.isComposing) {
    event.preventDefault();
    form.requestSubmit();
  }
});

async function restoreSession() {
  try {
    await request('session');
    showSession(true);
    status.textContent = '';
    await loadHistory();
  } catch (error) {
    showSession(false);
    if (error.status === 401) status.textContent = '';
    else showError(error);
  }
}
restoreSession();
"""

