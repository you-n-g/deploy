DEFAULT_PORT = 443
RECEIVER = "__msg_bridge_receiver__"
BATCH_DELAY = 0.5
DEFAULT_DB = Path.home() / ".local/share/msg-bridge/messages.sqlite3"
DEFAULT_PASSWORD_FILE = Path.home() / ".config/msg-bridge/web-password"
WEB_PAGE = r"""<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>发送消息 · Bridge</title>
  <link rel="stylesheet" href="./style.css">
  <script src="./app.js" defer></script>
</head>
<body>
  <main>
    <p class="label">MSG BRIDGE</p>
    <h1>发送消息</h1>
    <p class="intro">把想说的话，发送到当前连接的接收端。</p>
    <form id="login" hidden>
      <label for="password">访问密码</label>
      <input id="password" type="password" autocomplete="current-password" required>
      <div class="actions"><span>登录后保持 30 天</span><button type="submit">登录</button></div>
    </form>
    <div id="account" hidden><button id="logout" type="button">退出登录</button></div>
    <div id="workspace" hidden>
    <form id="sender">
      <label for="message">消息</label>
      <textarea id="message" rows="8" placeholder="在这里输入…" required></textarea>
