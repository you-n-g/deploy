#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["prompt_toolkit>=3,<4", "python-socks[asyncio]>=2,<3", "typer>=0.12,<1", "websockets>=15,<16"]
# ///

from __future__ import annotations

import asyncio
from contextlib import closing
from datetime import datetime, timezone
import os
from pathlib import Path
import socket
import sqlite3
import subprocess
import sys
import time
from typing import Annotated

import typer
import websockets

DEFAULT_HOST = "127.0.0.1"
DEFAULT_PORT = 443
RECEIVER = "__msg_bridge_receiver__"
BATCH_DELAY = 0.5
DEFAULT_DB = Path.home() / ".local/share/msg-bridge/messages.sqlite3"
app = typer.Typer(add_completion=False, help="Tiny sender / bridge / receiver for tmux message input")


async def bridge_loop(host: str, port: int, db_path: Path) -> None:
    receivers: set[websockets.ServerConnection] = set()
    db_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    db_path.touch(exist_ok=True, mode=0o600)

    with closing(sqlite3.connect(db_path)) as db:
        db.execute("""CREATE TABLE IF NOT EXISTS messages (
            id INTEGER PRIMARY KEY,
            received_at TEXT NOT NULL,
            content TEXT NOT NULL,
            char_count INTEGER NOT NULL,
            byte_count INTEGER NOT NULL
        )""")
        db.execute("CREATE INDEX IF NOT EXISTS messages_received_at ON messages(received_at)")
        db.commit()

        async def forward(msg: str) -> None:
            if not isinstance(msg, str):
                raise TypeError("msg-bridge only accepts text messages")
            db.execute(
                "INSERT INTO messages (received_at, content, char_count, byte_count) VALUES (?, ?, ?, ?)",
                (datetime.now(timezone.utc).isoformat(timespec="milliseconds"), msg, len(msg), len(msg.encode("utf-8"))),
            )
            db.commit()
            await broadcast(receivers, msg)

        async def handle(ws: websockets.ServerConnection) -> None:
            first = await ws.recv()
            if first == RECEIVER:
                receivers.add(ws)
                try:
                    await ws.wait_closed()
                finally:
                    receivers.discard(ws)
                return
            await forward(first)
            async for msg in ws:
                await forward(msg)

        async with websockets.serve(handle, host, port):
            print(f"msg-bridge b listening on ws://{host}:{port}; storing messages in {db_path}")
            await asyncio.Future()


async def broadcast(receivers: set[websockets.ServerConnection], msg: str) -> None:
    dead = []
    for ws in receivers:
        try:
            await ws.send(msg)
        except websockets.ConnectionClosed:
            dead.append(ws)
    for ws in dead:
        receivers.discard(ws)


def parse_endpoint(host: str, port: int) -> tuple[str, int]:
    if host.startswith("ws://"):
        host = host.removeprefix("ws://")
    if host.startswith("wss://"):
        raise SystemExit("wss:// is not supported by this tiny bridge")
    if ":" in host and host.rsplit(":", 1)[1].isdigit():
        host, port_text = host.rsplit(":", 1)
        port = int(port_text)
    return host, port


def ws_url(host: str, port: int) -> str:
    if ":" in host and not host.startswith("["):
        host = f"[{host}]"
    return f"ws://{host}:{port}"


def client_endpoint(host: str, port: int) -> tuple[str, int, str]:
    raw_host, port = parse_endpoint(host, port)
    infos = socket.getaddrinfo(raw_host, port, type=socket.SOCK_STREAM)
    ipv4 = [info for info in infos if info[0] == socket.AF_INET]
    resolved_host = (ipv4 or infos)[0][4][0]
    if resolved_host != raw_host:
        print(f"msg-bridge endpoint: {raw_host}:{port} -> {resolved_host}:{port}", flush=True)
    else:
        print(f"msg-bridge endpoint: {resolved_host}:{port}", flush=True)
    return resolved_host, port, ws_url(resolved_host, port)


async def send_loop(host: str, port: int, batch: bool) -> None:
    _, _, url = client_endpoint(host, port)
    pending: list[str] = []
    deadline = 0.0
    loop = asyncio.get_running_loop()
    session = None
    if sys.stdin.isatty():
        from prompt_toolkit.key_binding import KeyBindings
        from prompt_toolkit import PromptSession
        from prompt_toolkit.history import InMemoryHistory

        bindings = KeyBindings()

        @bindings.add("c-g")
        def _(event) -> None:
            event.app.current_buffer.open_in_editor()

        session = PromptSession(history=InMemoryHistory(), key_bindings=bindings)

        def on_text_changed(_buffer) -> None:
            nonlocal deadline
            if pending:
                deadline = loop.time() + BATCH_DELAY

        session.default_buffer.on_text_changed += on_text_changed

    async def read_message() -> str:
        if session:
            return await session.prompt_async(lambda: "[waiting] " if pending else "> ")
        return await asyncio.to_thread(input, "> ")

    def update_prompt() -> None:
        if session:
            session.app.invalidate()

    ws = await websockets.connect(url, open_timeout=60)

    async def send_message(msg: str) -> None:
        nonlocal ws
        try:
            await ws.send(msg)
        except websockets.ConnectionClosed:
            print("connection lost; reconnecting and retrying this message...", flush=True)
            ws = await websockets.connect(url, open_timeout=60)
            await ws.send(msg)

    async def flush_pending() -> None:
        await send_message(" ".join(pending))
        pending.clear()
        update_prompt()

    prompt_task = asyncio.create_task(read_message())
    try:
        print(f"type text, Ctrl-G edits in $EDITOR, Enter {'queues' if batch else 'sends'}; Ctrl-D exits")
        while True:
            try:
                if pending:
                    done, _ = await asyncio.wait({prompt_task}, timeout=max(0, deadline - loop.time()))
                    if not done:
                        if session and session.default_buffer.text:
                            deadline = loop.time() + BATCH_DELAY
                        elif loop.time() >= deadline:
                            await flush_pending()
                        continue
                msg = await prompt_task
            except EOFError:
                if pending:
                    await flush_pending()
                return
            prompt_task = asyncio.create_task(read_message())
            if not msg.strip():
                if pending:
                    deadline = loop.time() + BATCH_DELAY
                continue
            if batch:
                pending.append(msg)
                deadline = loop.time() + BATCH_DELAY
                update_prompt()
            else:
                await send_message(msg)
    finally:
        prompt_task.cancel()
        await ws.close()


def tmux(*args: str) -> str:
    return subprocess.check_output(["tmux", *args], text=True).strip()


def active_client_tty() -> str:
    clients = tmux("list-clients", "-F", "#{client_activity} #{client_tty}").splitlines()
    if not clients:
        raise SystemExit("msg-bridge r requires an attached tmux client unless --session is set")
    _activity, tty = max((line.split(maxsplit=1) for line in clients), key=lambda item: int(item[0]))
    return tty


def active_pane(session: str | None) -> str:
    if session:
        return tmux("display-message", "-p", "-t", f"{session}:", "#{pane_id}")
    if not os.environ.get("TMUX"):
        raise SystemExit("msg-bridge r must run inside tmux unless --session is set")
    return tmux("display-message", "-p", "-t", active_client_tty(), "#{pane_id}")


def inject(msg: str, session: str | None, enter_delay: float) -> None:
    pane = active_pane(session)
    buf = f"msg-bridge-{os.getpid()}-{time.time_ns()}"
    subprocess.run(["tmux", "set-buffer", "-b", buf, "--", msg], check=True)
    try:
        subprocess.run(["tmux", "paste-buffer", "-b", buf, "-t", pane], check=True)
        if enter_delay:
            time.sleep(enter_delay)
        subprocess.run(["tmux", "send-keys", "-t", pane, "Enter"], check=True)
    finally:
        subprocess.run(["tmux", "delete-buffer", "-b", buf], check=False)


async def receive_loop(host: str, port: int, session: str | None, enter_delay: float) -> None:
    _, _, url = client_endpoint(host, port)
    while True:
        try:
            async with websockets.connect(url, open_timeout=60) as ws:
                await ws.send(RECEIVER)
                async for msg in ws:
                    inject(msg, session, enter_delay)
        except (OSError, websockets.ConnectionClosed):
            await asyncio.sleep(1)


@app.command("b", help="bridge messages from senders to receivers")
def b(
    host: Annotated[str, typer.Option("--host", "-H")] = "0.0.0.0",
    port: Annotated[int, typer.Option("--port", "-P")] = DEFAULT_PORT,
    db_path: Annotated[Path, typer.Option("--db", help="SQLite message archive path")] = DEFAULT_DB,
) -> None:
    host, port = parse_endpoint(host, port)
    asyncio.run(bridge_loop(host, port, db_path))


@app.command("stats", help="show total and recent daily message counts")
def stats(
    db_path: Annotated[Path, typer.Option("--db", help="SQLite message archive path")] = DEFAULT_DB,
) -> None:
    if not db_path.is_file():
        raise SystemExit(f"msg-bridge database not found: {db_path}")
    with closing(sqlite3.connect(f"{db_path.resolve().as_uri()}?mode=ro", uri=True)) as db:
        total = db.execute("SELECT COUNT(*) FROM messages").fetchone()[0]
        print(f"total: {total}")
        for day, count in db.execute("""
            SELECT date(received_at, 'localtime'), COUNT(*)
            FROM messages
            GROUP BY date(received_at, 'localtime')
            ORDER BY date(received_at, 'localtime') DESC
            LIMIT 30
        """):
            print(f"{day}: {count}")


@app.command("s", help="send one-line messages after 500 ms of empty input by default")
def s(
    host: Annotated[str, typer.Option("--host", "-H")] = DEFAULT_HOST,
    port: Annotated[int, typer.Option("--port", "-P")] = DEFAULT_PORT,
    batch: Annotated[bool, typer.Option("--batch/--no-batch", help="Join messages after 500 ms of empty input")] = True,
) -> None:
    asyncio.run(send_loop(host, port, batch))


@app.command("r", help="receive messages and inject into tmux")
def r(
    host: Annotated[str, typer.Option("--host", "-H")] = DEFAULT_HOST,
    port: Annotated[int, typer.Option("--port", "-P")] = DEFAULT_PORT,
    session: Annotated[str | None, typer.Option("--session")] = None,
    enter_delay: Annotated[float, typer.Option("--enter-delay")] = 0.2,
) -> None:
    asyncio.run(receive_loop(host, port, session, enter_delay))


if __name__ == "__main__":
    try:
        app()
    except KeyboardInterrupt:
        sys.exit(130)
