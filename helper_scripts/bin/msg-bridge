@media (max-width: 480px) { body { padding: 6px 8px; } main { padding: 12px; } }
"""
SESSION_COOKIE = "msg_bridge_session"
SESSION_AGE = 30 * 24 * 60 * 60
app = typer.Typer(add_completion=False, help="Tiny sender / bridge / receiver for tmux message input")


def web_password(path: Path) -> str:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    if not path.exists():
        with open(path, "x", opener=lambda name, flags: os.open(name, flags, 0o600)) as file:
            file.write(secrets.token_urlsafe(24) + "\n")
    password = path.read_text().strip()
    if not password:
        raise ValueError(f"Web password file is empty: {path}")
    return password


def web_app(
    password: str, forward: Callable[[str, bool, str | None], Awaitable[dict]],
    history: Callable[[], list[dict]],
    receipt: Callable[[str], dict | None],
    saved: Callable[[], list[dict]],
    save: Callable[[str, str], dict],
    remove_saved: Callable[[str], None],
    favorites: Callable[[], list[dict]],
    add_favorite: Callable[[str, int], dict],
    remove_favorite: Callable[[int], None],
    reorder_favorites: Callable[[list[int], int | None], list[dict]],
    favorite_groups: Callable[[], list[dict]],
    manage_favorite_group: Callable[[str, dict], dict],
    favorite_group_order: Callable[[], list[int]],
) -> web.Application:
    response_headers = {
        "Cache-Control": "no-store",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "no-referrer",
        "Content-Security-Policy": (
            "default-src 'none'; script-src 'self' 'sha256-"
            + base64.b64encode(hashlib.sha256(WEB_SCRIPT.encode()).digest()).decode()
            + "'; style-src 'self' 'sha256-"
            + base64.b64encode(hashlib.sha256(WEB_STYLE.encode()).digest()).decode()
            + "'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        ),
    }

    def finish_response(request, response):
        nonce = request.get("session_nonce")
        response.headers["X-Bridge-Authenticated"] = "1" if nonce is not None else "0"
        if nonce is not None and SESSION_COOKIE not in response.cookies:
            expires = int(time.time()) + SESSION_AGE
            token = f"{expires}.{nonce}"
            response.set_cookie(SESSION_COOKIE, f"{token}.{signature(token)}", max_age=SESSION_AGE,
                                expires=formatdate(expires, usegmt=True), path="/send/",
                                secure=True, httponly=True, samesite="Lax")
        response.headers.update(response_headers)
        return response

    @web.middleware
    async def headers(request, handler):
        try:
            response = await handler(request)
        except web.HTTPException as error:
            finish_response(request, error)
            raise
        return finish_response(request, response)

    async def page(request):
        try:
            require_session(request)
        except web.HTTPUnauthorized:
            state = {"authenticated": False}
        else:
            state = {"authenticated": True, "messages": history(), "saved": saved(), "favorites": favorites(), "favorite_groups": favorite_groups(), "favorite_group_order": favorite_group_order()}
        page_html = WEB_PAGE.replace('<link rel="stylesheet" href="./style.css">', f'<style>{WEB_STYLE}</style>')
        page_html = page_html.replace('<script src="./app.js" defer></script>', '')
        page_html = page_html.replace('</body>',
            '<template id="initial-state">' + html.escape(json.dumps(state, ensure_ascii=False))
            + f'</template><script>{WEB_SCRIPT}</script></body>')
        return web.Response(text=page_html, content_type="text/html")

    async def redirect(request):
        raise web.HTTPPermanentRedirect("/send/")

    async def asset(request):
        name = request.match_info["name"]
        content_type = "text/javascript" if name == "app.js" else "text/css"
        return web.Response(text={"app.js": WEB_SCRIPT, "style.css": WEB_STYLE}[name], content_type=content_type)

    def signature(payload: str) -> str:
        return hmac.new(password.encode(), payload.encode(), "sha256").hexdigest()

    def require_session(request):
        token = request.cookies.get(SESSION_COOKIE, "")
        try:
            expires, nonce, signed = token.split(".")
            valid_until = int(expires)
        except ValueError:
            raise web.HTTPUnauthorized(text="请先登录")
        if valid_until <= time.time() or not secrets.compare_digest(signed.encode(), signature(f"{expires}.{nonce}").encode()):
            raise web.HTTPUnauthorized(text="登录已过期，请重新登录")
        request["session_nonce"] = nonce

    async def json_body(request):
        if request.content_type != "application/json":
            raise web.HTTPUnsupportedMediaType(text="请求必须使用 JSON")
        try:
            payload = await request.json()
        except (json.JSONDecodeError, UnicodeDecodeError):
            raise web.HTTPBadRequest(text="JSON 格式错误")
        if not isinstance(payload, dict):
            raise web.HTTPBadRequest(text="JSON 必须为对象")
        return payload

    async def login(request):
        payload = await json_body(request)
        provided = payload.get("password")
        if not isinstance(provided, str) or not secrets.compare_digest(provided.encode(), password.encode()):
            raise web.HTTPUnauthorized(text="密码错误")
        request["session_nonce"] = secrets.token_urlsafe(24)
        return web.json_response({"authenticated": True})

    async def session(request):
        require_session(request)
        return web.json_response({"authenticated": True})

    async def logout(request):
        await json_body(request)
        response = web.json_response({"authenticated": False})
        response.del_cookie(SESSION_COOKIE, path="/send/")
        return response

    async def send(request):
        require_session(request)
        payload = await json_body(request)
        message = payload.get("message")
        if not isinstance(message, str) or not message.strip():
            raise web.HTTPBadRequest(text="请输入消息")
        if message == RECEIVER:
            raise web.HTTPBadRequest(text="不能发送 bridge 的保留连接标记")
        submit = payload.get("submit", True)
        if not isinstance(submit, bool):
            raise web.HTTPBadRequest(text="submit 必须为布尔值")
        request_id = payload.get("request_id")
        if request_id is not None:
            validate_request_id(request_id)
        result = await forward(message, submit, request_id)
        return web.json_response(result, status=202 if result.get("status") == "pending" else 200)

    def validate_request_id(request_id):
        if not isinstance(request_id, str) or len(request_id) != 32 or any(c not in "0123456789abcdef" for c in request_id):
            raise web.HTTPBadRequest(text="request_id 必须为 32 位十六进制字符串")

    async def request_receipt(request):
        require_session(request)
        request_id = request.match_info["request_id"]
        validate_request_id(request_id)
        result = receipt(request_id)
        if result is None:
            raise web.HTTPNotFound(text="尚未找到该请求")
        return web.json_response(result)

    async def recent_messages(request):
        require_session(request)
        return web.json_response({"messages": history(), "saved": saved(), "favorites": favorites(), "favorite_groups": favorite_groups(), "favorite_group_order": favorite_group_order()})

    async def save_message(request):
        require_session(request)
        payload = await json_body(request)
        message = payload.get("message")
        if not isinstance(message, str) or not message.strip() or message == RECEIVER:
            raise web.HTTPBadRequest(text="请输入要暂存的消息")
        request_id = payload.get("request_id")
        validate_request_id(request_id)
        return web.json_response(save(message, request_id))

    async def delete_saved_message(request):
        require_session(request)
        request_id = request.match_info["request_id"]
        validate_request_id(request_id)
        remove_saved(request_id)
        return web.json_response({"deleted": request_id})

    def validate_group_id(value):
        if type(value) is not int or value < 0 or value > 9223372036854775807:
            raise web.HTTPBadRequest(text="分组编号必须为非负整数")

    def validate_favorite_ids(ids):
        if not isinstance(ids, list) or any(type(value) is not int or value < 1 or value > 9223372036854775807 for value in ids) or len(set(ids)) != len(ids):
            raise web.HTTPBadRequest(text="收藏编号必须是不重复的正整数列表")

    async def group_action(request):
        require_session(request)
        payload = await json_body(request)
        if request.method == "PATCH":
            action = "rename"
            payload["group_id"] = int(request.match_info["group_id"])
        elif request.path.endswith("/favorite-groups/order"):
            action = "order"
            ids = payload.get("ids")
            if not isinstance(ids, list):
                raise web.HTTPBadRequest(text="请提供分组顺序列表")
            for value in ids:
                validate_group_id(value)
            if len(set(ids)) != len(ids):
                raise web.HTTPBadRequest(text="分组编号不能重复")
        elif request.path.endswith("/move"):
            action = "move"
            validate_favorite_ids(payload.get("ids"))
            if not payload["ids"]:
                raise web.HTTPBadRequest(text="请先选择收藏消息")
            validate_group_id(payload.get("group_id"))
            if "order" in payload:
                validate_favorite_ids(payload["order"])
        else:
            action = "create"
        if action in ("create", "rename"):
            name = payload.get("name")
            if not isinstance(name, str) or not name.strip() or len(name.strip()) > 40 or name.strip() in ("全部", "未分组"):
                raise web.HTTPBadRequest(text="分组名称须为 1 至 40 个字符，不能使用「全部」或「未分组」")
            payload["name"] = name.strip()
            if action == "create" and "ids" in payload:
                validate_favorite_ids(payload["ids"])
        return web.json_response(manage_favorite_group(action, payload))

    async def favorite_message(request):
        require_session(request)
        payload = await json_body(request)
        message = payload.get("message")
        if not isinstance(message, str) or not message.strip() or message == RECEIVER:
            raise web.HTTPBadRequest(text="请输入要收藏的消息")
        group_id = payload.get("group_id", 0)
        validate_group_id(group_id)
        return web.json_response(add_favorite(message, group_id))

    async def order_favorites(request):
        require_session(request)
        payload = await json_body(request)
        ids = payload.get("ids")
        validate_favorite_ids(ids)
        group_id = payload.get("group_id")
        if group_id is not None:
            validate_group_id(group_id)
        return web.json_response({"favorites": reorder_favorites(ids, group_id)})

    async def delete_favorite(request):
        require_session(request)
        favorite_id = request.match_info["favorite_id"]
        if not favorite_id.isascii() or not favorite_id.isdigit() or len(favorite_id) > 18 or int(favorite_id) < 1:
            raise web.HTTPBadRequest(text="收藏编号必须为正整数")
        remove_favorite(int(favorite_id))
        return web.json_response({"deleted": int(favorite_id)})

    application = web.Application(middlewares=[headers], client_max_size=1024 * 1024)
    application.router.add_get("/send", redirect)
    application.router.add_get("/send/", page)
    application.router.add_get("/send/{name:app\\.js|style\\.css}", asset)
    application.router.add_post("/send/api/login", login)
    application.router.add_get("/send/api/session", session)
    application.router.add_post("/send/api/logout", logout)
    application.router.add_get("/send/api/messages", recent_messages)
    application.router.add_post("/send/api/messages", send)
    application.router.add_post("/send/api/favorite-groups/order", group_action)
    application.router.add_post("/send/api/favorite-groups", group_action)
    application.router.add_patch(r"/send/api/favorite-groups/{group_id:\d{1,18}}", group_action)
    application.router.add_post("/send/api/favorites/move", group_action)
    application.router.add_post("/send/api/favorites/order", order_favorites)
    application.router.add_post("/send/api/favorites", favorite_message)
    application.router.add_delete("/send/api/favorites/{favorite_id}", delete_favorite)
    application.router.add_post("/send/api/saved", save_message)
    application.router.add_delete("/send/api/saved/{request_id}", delete_saved_message)
    application.router.add_get("/send/api/requests/{request_id}", request_receipt)
    return application


async def bridge_loop(
    host: str, port: int, db_path: Path, *, web_host: str = DEFAULT_HOST,
    web_port: int | None = None, password_file: Path = DEFAULT_PASSWORD_FILE,
    web_cert: Path | None = None, web_key: Path | None = None,
) -> None:
    tls = None
    if bool(web_cert) != bool(web_key):
        raise ValueError("--web-cert and --web-key must be provided together")
    if web_cert and web_port is None:
        raise ValueError("--web-cert requires --web-port")
    if web_cert:
        tls = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        tls.load_cert_chain(web_cert, web_key)
    if web_port is not None and tls is None and web_host not in {"127.0.0.1", "::1", "localhost"}:
        raise ValueError("Plain HTTP must bind to loopback; use --web-cert/--web-key for public HTTPS")
    password = web_password(password_file) if web_port is not None else None
    receivers: dict[websockets.ServerConnection, bool] = {}
    db_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    db_path.touch(exist_ok=True, mode=0o600)

    with closing(sqlite3.connect(db_path)) as db:
        db.execute("""CREATE TABLE IF NOT EXISTS messages (
            id INTEGER PRIMARY KEY,
            received_at TEXT NOT NULL,
            content TEXT NOT NULL,
            char_count INTEGER NOT NULL,
            byte_count INTEGER NOT NULL
        )""")
        db.execute("CREATE INDEX IF NOT EXISTS messages_received_at ON messages(received_at)")
        db.execute("""CREATE TABLE IF NOT EXISTS web_requests (
            request_id TEXT PRIMARY KEY,
            message_id INTEGER NOT NULL REFERENCES messages(id),
            submit INTEGER NOT NULL,
            receivers INTEGER
        )""")
        db.execute("""CREATE TABLE IF NOT EXISTS saved_messages (
            id TEXT PRIMARY KEY,
            created_at TEXT NOT NULL,
            content TEXT NOT NULL
        )""")
        db.execute("""CREATE TABLE IF NOT EXISTS favorite_messages (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            created_at TEXT NOT NULL,
            content TEXT NOT NULL UNIQUE
        )""")
        db.execute("CREATE TABLE IF NOT EXISTS favorite_groups (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL UNIQUE)")
        db.execute("CREATE TABLE IF NOT EXISTS favorite_group_layout (group_id INTEGER PRIMARY KEY, position INTEGER NOT NULL)")
        db.execute("CREATE TABLE IF NOT EXISTS favorite_membership (favorite_id INTEGER PRIMARY KEY, group_id INTEGER NOT NULL)")
        db.execute("CREATE TABLE IF NOT EXISTS favorite_group_order (favorite_id INTEGER PRIMARY KEY, group_id INTEGER NOT NULL, position INTEGER NOT NULL)")
        db.execute("CREATE TABLE IF NOT EXISTS favorite_order (favorite_id INTEGER PRIMARY KEY, position INTEGER NOT NULL)")
        db.execute("CREATE TABLE IF NOT EXISTS deleted_saved_messages (id TEXT PRIMARY KEY)")
        db.commit()

        def favorite_group_order() -> list[int]:
            return [row[0] for row in db.execute("""SELECT g.id FROM (SELECT 0 AS id UNION ALL SELECT id FROM favorite_groups) g
                LEFT JOIN favorite_group_layout o ON o.group_id = g.id
                ORDER BY o.position IS NULL ASC, o.position ASC, g.id ASC""")]

        def favorite_groups() -> list[dict]:
            return [{"id": row[0], "name": row[1]} for row in db.execute("SELECT id, name FROM favorite_groups ORDER BY id")]

        def require_group(group_id: int) -> None:
            if group_id != 0 and db.execute("SELECT 1 FROM favorite_groups WHERE id = ?", (group_id,)).fetchone() is None:
                raise web.HTTPNotFound(text="分组不存在，请刷新")

        def favorites() -> list[dict]:
            rows = db.execute("""SELECT f.id, f.created_at, f.content, COALESCE(m.group_id, 0), g.position
                FROM favorite_messages f LEFT JOIN favorite_order o ON o.favorite_id = f.id
                LEFT JOIN favorite_membership m ON m.favorite_id = f.id
                LEFT JOIN favorite_group_order g ON g.favorite_id = f.id AND g.group_id = COALESCE(m.group_id, 0)
                ORDER BY o.position ASC, f.created_at DESC, f.id DESC""").fetchall()
            return [{"id": row[0], "created_at": row[1], "content": row[2], "group_id": row[3], "group_position": row[4]} for row in rows]

        def reorder_favorites(ids: list[int], group_id: int | None) -> list[dict]:
            if group_id is not None:
                require_group(group_id)
            current = {entry["id"] for entry in favorites() if group_id is None or entry["group_id"] == group_id}
            if set(ids) != current:
                raise web.HTTPConflict(text="收藏列表已改变，请刷新后重新排序")
            with db:
                if group_id is None:
                    db.execute("DELETE FROM favorite_order")
                    db.executemany("INSERT INTO favorite_order (favorite_id, position) VALUES (?, ?)",
                                   [(favorite_id, position) for position, favorite_id in enumerate(ids)])
                else:
                    db.execute("DELETE FROM favorite_group_order WHERE group_id = ?", (group_id,))
                    db.executemany("INSERT INTO favorite_group_order (favorite_id, group_id, position) VALUES (?, ?, ?)",
                                   [(favorite_id, group_id, position) for position, favorite_id in enumerate(ids)])
            return favorites()

        def add_favorite(message: str, group_id: int) -> dict:
            require_group(group_id)
            created_at = datetime.now(timezone.utc).isoformat(timespec="milliseconds")
            with db:
                inserted = db.execute("INSERT INTO favorite_messages (created_at, content) VALUES (?, ?) ON CONFLICT(content) DO NOTHING", (created_at, message))
                if inserted.rowcount:
                    db.execute("INSERT INTO favorite_membership (favorite_id, group_id) VALUES (?, ?)", (inserted.lastrowid, group_id))
            return next(entry for entry in favorites() if entry["content"] == message)

        def manage_favorite_group(action: str, payload: dict) -> dict:
            if action == "order":
                ids = payload["ids"]
                if set(ids) != set(favorite_group_order()):
                    raise web.HTTPConflict(text="分组列表已改变，请刷新后重新排序")
                with db:
                    db.execute("DELETE FROM favorite_group_layout")
                    db.executemany("INSERT INTO favorite_group_layout (group_id, position) VALUES (?, ?)", [(value, position) for position, value in enumerate(ids)])
            elif action == "move":
                group_id = payload["group_id"]
                require_group(group_id)
                ids = payload["ids"]
                current = {entry["id"] for entry in favorites()}
                if not set(ids) <= current:
                    raise web.HTTPConflict(text="收藏列表已改变，请刷新后重试")
                if "order" in payload:
                    expected = {entry["id"] for entry in favorites() if entry["group_id"] == group_id} | set(ids)
                    if set(payload["order"]) != expected:
                        raise web.HTTPConflict(text="目标分组已改变，请刷新后重试")
                # Moving within the same group preserves its order.
                changed = [entry["id"] for entry in favorites() if entry["id"] in ids and entry["group_id"] != group_id]
                with db:
                    db.executemany("INSERT INTO favorite_membership (favorite_id, group_id) VALUES (?, ?) ON CONFLICT(favorite_id) DO UPDATE SET group_id = excluded.group_id", [(value, group_id) for value in changed])
                    db.executemany("DELETE FROM favorite_group_order WHERE favorite_id = ?", [(value,) for value in changed])
                    if "order" in payload:
                        db.execute("DELETE FROM favorite_group_order WHERE group_id = ?", (group_id,))
                        db.executemany("INSERT INTO favorite_group_order (favorite_id, group_id, position) VALUES (?, ?, ?)", [(value, group_id, position) for position, value in enumerate(payload["order"])])
            else:
                name = payload["name"]
                group_id = payload["group_id"] if action == "rename" else None
                if action == "rename":
                    if group_id == 0:
                        raise web.HTTPBadRequest(text="未分组不能重命名")
                    require_group(group_id)
                existing = db.execute("SELECT id FROM favorite_groups WHERE name = ?", (name,)).fetchone()
                if existing is not None and existing[0] != group_id:
                    raise web.HTTPConflict(text="已存在同名分组")
                with db:
                    if action == "create":
                        ids = payload.get("ids", [])
                        current = {entry["id"] for entry in favorites()}
                        if not set(ids) <= current:
                            raise web.HTTPConflict(text="收藏列表已改变，请刷新后重试")
                        created = db.execute("INSERT INTO favorite_groups (name) VALUES (?)", (name,))
                        db.executemany("INSERT INTO favorite_membership (favorite_id, group_id) VALUES (?, ?) ON CONFLICT(favorite_id) DO UPDATE SET group_id = excluded.group_id", [(value, created.lastrowid) for value in ids])
                        db.executemany("DELETE FROM favorite_group_order WHERE favorite_id = ?", [(value,) for value in ids])
                    else:
                        db.execute("UPDATE favorite_groups SET name = ? WHERE id = ?", (name, group_id))
            return {"favorites": favorites(), "favorite_groups": favorite_groups(), "favorite_group_order": favorite_group_order()}

        def remove_favorite(favorite_id: int) -> None:
            db.execute("DELETE FROM favorite_group_order WHERE favorite_id = ?", (favorite_id,))
            db.execute("DELETE FROM favorite_membership WHERE favorite_id = ?", (favorite_id,))
            db.execute("DELETE FROM favorite_order WHERE favorite_id = ?", (favorite_id,))
            db.execute("DELETE FROM favorite_messages WHERE id = ?", (favorite_id,))
            db.commit()

        def saved() -> list[dict]:
            rows = db.execute("SELECT id, created_at, content FROM saved_messages ORDER BY created_at DESC, rowid DESC").fetchall()
            return [{"id": row[0], "created_at": row[1], "content": row[2]} for row in rows]

        def save(message: str, request_id: str) -> dict:
            if db.execute("SELECT 1 FROM deleted_saved_messages WHERE id = ?", (request_id,)).fetchone():
                raise web.HTTPConflict(text="这条暂存消息已删除，不能重新使用原编号")
            converted = db.execute("SELECT 1 FROM web_requests WHERE request_id = ?", (request_id,)).fetchone()
            if converted is not None:
                raise web.HTTPConflict(text="这条暂存消息已进入发送流程，请刷新列表查看结果")
            existing = db.execute("SELECT created_at, content FROM saved_messages WHERE id = ?", (request_id,)).fetchone()
            if existing is not None:
                if existing[1] != message:
                    raise web.HTTPConflict(text="同一暂存编号不能用于不同内容")
                created_at = existing[0]
            else:
                created_at = datetime.now(timezone.utc).isoformat(timespec="milliseconds")
                db.execute("INSERT INTO saved_messages (id, created_at, content) VALUES (?, ?, ?)", (request_id, created_at, message))
                db.commit()
            return {"id": request_id, "created_at": created_at, "content": message}

        def remove_saved(request_id: str) -> None:
            if db.execute("SELECT 1 FROM web_requests WHERE request_id = ?", (request_id,)).fetchone():
                raise web.HTTPConflict(text="这条消息已进入发送流程，删除暂存不能撤销发送，请刷新列表")
            db.execute("INSERT OR IGNORE INTO deleted_saved_messages (id) VALUES (?)", (request_id,))
            db.execute("DELETE FROM saved_messages WHERE id = ?", (request_id,))
            db.commit()

        def receipt(request_id: str) -> dict | None:
            row = db.execute("SELECT message_id, receivers FROM web_requests WHERE request_id = ?", (request_id,)).fetchone()
            if row is None:
                return None
            return {"request_id": request_id, "message_id": row[0], "receivers": row[1],
                    "status": "pending" if row[1] is None else "sent"}

        async def forward(msg: str, submit: bool = True, request_id: str | None = None) -> dict:
            started = time.monotonic()
            if not isinstance(msg, str):
                raise TypeError("msg-bridge only accepts text messages")
            if request_id is not None:
                if db.execute("SELECT 1 FROM deleted_saved_messages WHERE id = ?", (request_id,)).fetchone():
                    raise web.HTTPConflict(text="这条暂存消息已删除，请刷新列表")
                stored = db.execute("SELECT content FROM saved_messages WHERE id = ?", (request_id,)).fetchone()
                if stored is not None and stored[0] != msg:
                    raise web.HTTPConflict(text="暂存消息的发送内容必须与原文一致")
                existing = db.execute("""SELECT m.content, r.submit FROM web_requests r
                    JOIN messages m ON m.id = r.message_id WHERE r.request_id = ?""", (request_id,)).fetchone()
                if existing is not None:
                    if existing != (msg, int(submit)):
                        raise web.HTTPConflict(text="同一 request_id 不能用于不同消息或发送模式")
                    return receipt(request_id)
            if not submit and not all(receivers.values()):
                raise web.HTTPConflict(text="有旧版接收端在线：请先更新并重启 msg-bridge r，才能发送但不回车")
            inserted = db.execute(
                "INSERT INTO messages (received_at, content, char_count, byte_count) VALUES (?, ?, ?, ?)",
                (datetime.now(timezone.utc).isoformat(timespec="milliseconds"), msg, len(msg), len(msg.encode("utf-8"))),
            )
            if request_id is not None:
                db.execute("INSERT INTO web_requests (request_id, message_id, submit) VALUES (?, ?, ?)",
                           (request_id, inserted.lastrowid, int(submit)))
            db.commit()
            delivered = await broadcast(receivers, msg, submit)
            if request_id is not None:
                db.execute("UPDATE web_requests SET receivers = ? WHERE request_id = ?", (delivered, request_id))
                db.execute("DELETE FROM saved_messages WHERE id = ?", (request_id,))
                db.commit()
            print(f"forwarded id={inserted.lastrowid} request_id={request_id or '-'} submit={submit} receivers={delivered} chars={len(msg)} duration_ms={(time.monotonic() - started) * 1000:.1f}", flush=True)
            return receipt(request_id) if request_id is not None else {"receivers": delivered}

        def history() -> list[dict]:
            rows = db.execute(
                "SELECT id, received_at, content FROM messages ORDER BY id DESC LIMIT 50"
            ).fetchall()
            return [{"id": row[0], "received_at": row[1], "content": row[2]} for row in rows]

        async def handle(ws: websockets.ServerConnection) -> None:
            first = await ws.recv()
            if first == RECEIVER:
                receivers[ws] = ws.subprotocol == RECEIVER_PROTOCOL
                print(f"receiver connected id={ws.id} protocol={ws.subprotocol or 'legacy'} receivers={len(receivers)}", flush=True)
                try:
                    await ws.wait_closed()
                finally:
                    del receivers[ws]
                    print(f"receiver disconnected id={ws.id} receivers={len(receivers)}", flush=True)
                return
            await forward(first)
            async for msg in ws:
                await forward(msg)

        async with websockets.serve(
            handle, host, port, subprotocols=[RECEIVER_PROTOCOL],
            select_subprotocol=lambda connection, offered: RECEIVER_PROTOCOL if RECEIVER_PROTOCOL in offered else None,
        ):
            print(f"msg-bridge b listening on ws://{host}:{port}; storing messages in {db_path}")
            runner = web.AppRunner(web_app(password, forward, history, receipt, saved, save, remove_saved, favorites, add_favorite, remove_favorite, reorder_favorites, favorite_groups, manage_favorite_group, favorite_group_order)) if password is not None else None
            try:
                if runner:
                    await runner.setup()
                    await web.TCPSite(runner, web_host, web_port, ssl_context=tls).start()
                    print(f"Web sender: {'https' if tls else 'http'}://{web_host}:{web_port}/send/; password file: {password_file}", flush=True)
                await asyncio.Future()
            finally:
                if runner:
                    await runner.cleanup()


async def broadcast(receivers: dict[websockets.ServerConnection, bool], msg: str, submit: bool = True) -> int:
    delivered = 0
    for ws, structured in tuple(receivers.items()):
        try:
            await ws.send(json.dumps({"message": msg, "submit": submit}, ensure_ascii=False) if structured else msg)
            delivered += 1
        except websockets.ConnectionClosed:
            # The receiver handler removes the connection when wait_closed() completes.
            continue
    return delivered


def parse_endpoint(host: str, port: int) -> tuple[str, int]:
    if host.startswith("ws://"):
        host = host.removeprefix("ws://")
    if host.startswith("wss://"):
        raise SystemExit("wss:// is not supported by this tiny bridge")
    if ":" in host and host.rsplit(":", 1)[1].isdigit():
        host, port_text = host.rsplit(":", 1)
        port = int(port_text)
    return host, port


def ws_url(host: str, port: int) -> str:
    if ":" in host and not host.startswith("["):
        host = f"[{host}]"
    return f"ws://{host}:{port}"


def client_endpoint(host: str, port: int) -> tuple[str, int, str]:
    raw_host, port = parse_endpoint(host, port)
    infos = socket.getaddrinfo(raw_host, port, type=socket.SOCK_STREAM)
    ipv4 = [info for info in infos if info[0] == socket.AF_INET]
    resolved_host = (ipv4 or infos)[0][4][0]
    if resolved_host != raw_host:
        print(f"msg-bridge endpoint: {raw_host}:{port} -> {resolved_host}:{port}", flush=True)
    else:
        print(f"msg-bridge endpoint: {resolved_host}:{port}", flush=True)
    return resolved_host, port, ws_url(resolved_host, port)


async def send_loop(host: str, port: int, batch: bool) -> None:
    _, _, url = client_endpoint(host, port)
    pending: list[str] = []
    deadline = 0.0
    loop = asyncio.get_running_loop()
    session = None
    if sys.stdin.isatty():
        from prompt_toolkit.key_binding import KeyBindings
        from prompt_toolkit import PromptSession
        from prompt_toolkit.history import InMemoryHistory

        bindings = KeyBindings()

        @bindings.add("c-g")
        def _(event) -> None:
            event.app.current_buffer.open_in_editor()

        session = PromptSession(history=InMemoryHistory(), key_bindings=bindings)

        def on_text_changed(_buffer) -> None:
            nonlocal deadline
            if pending:
                deadline = loop.time() + BATCH_DELAY

        session.default_buffer.on_text_changed += on_text_changed

    async def read_message() -> str:
        if session:
            return await session.prompt_async(lambda: "[waiting] " if pending else "> ")
        return await asyncio.to_thread(input, "> ")

    def update_prompt() -> None:
        if session:
            session.app.invalidate()

    ws = await websockets.connect(url, open_timeout=60)

    async def send_message(msg: str) -> None:
        nonlocal ws
        try:
            await ws.send(msg)
        except websockets.ConnectionClosed:
            print("connection lost; reconnecting and retrying this message...", flush=True)
            ws = await websockets.connect(url, open_timeout=60)
            await ws.send(msg)

    async def flush_pending() -> None:
        await send_message(" ".join(pending))
        pending.clear()
        update_prompt()

    prompt_task = asyncio.create_task(read_message())
    try:
        print(f"type text, Ctrl-G edits in $EDITOR, Enter {'queues' if batch else 'sends'}; Ctrl-D exits")
        while True:
            try:
                if pending:
                    done, _ = await asyncio.wait({prompt_task}, timeout=max(0, deadline - loop.time()))
                    if not done:
                        if session and session.default_buffer.text:
                            deadline = loop.time() + BATCH_DELAY
                        elif loop.time() >= deadline:
                            await flush_pending()
                        continue
                msg = await prompt_task
            except EOFError:
                if pending:
                    await flush_pending()
                return
            prompt_task = asyncio.create_task(read_message())
            if not msg.strip():
                if pending:
                    deadline = loop.time() + BATCH_DELAY
                continue
            if batch:
                pending.append(msg)
                deadline = loop.time() + BATCH_DELAY
                update_prompt()
            else:
                await send_message(msg)
    finally:
        prompt_task.cancel()
        await ws.close()


def tmux(*args: str) -> str:
    return subprocess.check_output(["tmux", *args], text=True).strip()


def active_client_tty() -> str:
    clients = tmux("list-clients", "-F", "#{client_activity} #{client_tty}").splitlines()
    if not clients:
        raise SystemExit("msg-bridge r requires an attached tmux client unless --session is set")
    _activity, tty = max((line.split(maxsplit=1) for line in clients), key=lambda item: int(item[0]))
    return tty


def active_pane(session: str | None) -> str:
    if session:
        return tmux("display-message", "-p", "-t", f"{session}:", "#{pane_id}")
    if not os.environ.get("TMUX"):
        raise SystemExit("msg-bridge r must run inside tmux unless --session is set")
    return tmux("display-message", "-p", "-t", active_client_tty(), "#{pane_id}")


def inject(msg: str, session: str | None, enter_delay: float, *, submit: bool = True) -> None:
    pane = active_pane(session)
    buf = f"msg-bridge-{os.getpid()}-{time.time_ns()}"
    subprocess.run(["tmux", "set-buffer", "-b", buf, "--", msg], check=True)
    try:
        subprocess.run(["tmux", "paste-buffer", "-p", "-b", buf, "-t", pane], check=True)
        if submit:
            if enter_delay:
                time.sleep(enter_delay)
            subprocess.run(["tmux", "send-keys", "-t", pane, "Enter"], check=True)
        print(f"injected pane={pane} submit={submit} chars={len(msg)}", flush=True)
    finally:
        subprocess.run(["tmux", "delete-buffer", "-b", buf], check=False)


async def receive_loop(host: str, port: int, session: str | None, enter_delay: float) -> None:
    _, _, url = client_endpoint(host, port)
    while True:
        try:
            async with websockets.connect(url, open_timeout=60, subprotocols=[RECEIVER_PROTOCOL]) as ws:
                await ws.send(RECEIVER)
                async for msg in ws:
                    if ws.subprotocol == RECEIVER_PROTOCOL:
                        payload = json.loads(msg)
                        if not isinstance(payload, dict) or not isinstance(payload.get("message"), str) or not isinstance(payload.get("submit"), bool):
                            raise ValueError("Invalid structured message from bridge")
                        inject(payload["message"], session, enter_delay, submit=payload["submit"])
                    else:
                        inject(msg, session, enter_delay)
        except (OSError, websockets.ConnectionClosed):
            await asyncio.sleep(1)


@app.command("b", help="bridge messages from senders to receivers")
def b(
    host: Annotated[str, typer.Option("--host", "-H")] = "0.0.0.0",
    port: Annotated[int, typer.Option("--port", "-P")] = DEFAULT_PORT,
    db_path: Annotated[Path, typer.Option("--db", help="SQLite message archive path")] = DEFAULT_DB,
    web_port: Annotated[int | None, typer.Option(help="Enable the /send/ web page on this port")] = None,
    web_host: Annotated[str, typer.Option(help="Web listener bind address")] = DEFAULT_HOST,
    password_file: Annotated[Path, typer.Option(help="Web password file; generated on first start")] = DEFAULT_PASSWORD_FILE,
    web_cert: Annotated[Path | None, typer.Option(help="HTTPS certificate PEM")] = None,
    web_key: Annotated[Path | None, typer.Option(help="HTTPS private key PEM")] = None,
) -> None:
    host, port = parse_endpoint(host, port)
    asyncio.run(bridge_loop(host, port, db_path, web_host=web_host, web_port=web_port,
                            password_file=password_file, web_cert=web_cert, web_key=web_key))


@app.command("stats", help="show total and recent daily message counts")
def stats(
    db_path: Annotated[Path, typer.Option("--db", help="SQLite message archive path")] = DEFAULT_DB,
) -> None:
    if not db_path.is_file():
        raise SystemExit(f"msg-bridge database not found: {db_path}")
    with closing(sqlite3.connect(f"{db_path.resolve().as_uri()}?mode=ro", uri=True)) as db:
        total = db.execute("SELECT COUNT(*) FROM messages").fetchone()[0]
        print(f"total: {total}")
        for day, count in db.execute("""
            SELECT date(received_at, 'localtime'), COUNT(*)
            FROM messages
            GROUP BY date(received_at, 'localtime')
            ORDER BY date(received_at, 'localtime') DESC
            LIMIT 30
        """):
            print(f"{day}: {count}")


@app.command("s", help="send one-line messages after 500 ms of empty input by default")
def s(
    host: Annotated[str, typer.Option("--host", "-H")] = DEFAULT_HOST,
    port: Annotated[int, typer.Option("--port", "-P")] = DEFAULT_PORT,
    batch: Annotated[bool, typer.Option("--batch/--no-batch", help="Join messages after 500 ms of empty input")] = True,
) -> None:
    asyncio.run(send_loop(host, port, batch))


@app.command("r", help="receive messages and inject into tmux")
def r(
    host: Annotated[str, typer.Option("--host", "-H")] = DEFAULT_HOST,
    port: Annotated[int, typer.Option("--port", "-P")] = DEFAULT_PORT,
    session: Annotated[str | None, typer.Option("--session")] = None,
    enter_delay: Annotated[float, typer.Option("--enter-delay", help="Seconds to wait after paste before pressing Enter")] = DEFAULT_ENTER_DELAY,
) -> None:
    asyncio.run(receive_loop(host, port, session, enter_delay))


if __name__ == "__main__":
    try:
        app()
    except KeyboardInterrupt:
        sys.exit(130)
