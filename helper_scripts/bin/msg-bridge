WEB_SCRIPT = r"""const form = document.querySelector('#sender');
const login = document.querySelector('#login');
const account = document.querySelector('#account');
const logout = document.querySelector('#logout');
const password = document.querySelector('#password');
const message = document.querySelector('#message');
const button = document.querySelector('#send-submit');
const leftButton = document.querySelector('#send-left');
const draftButton = document.querySelector('#send-draft');
const saveButton = document.querySelector('#save-message');
const savedList = document.querySelector('#saved-list');
const favoriteList = document.querySelector('#favorite-list');
const favoriteNewGroup = document.querySelector('#favorite-new-group');
const favoriteNewOpen = document.querySelector('#favorite-new-open');
const favoriteNewEditor = document.querySelector('#favorite-new-editor');
const favoriteNewName = document.querySelector('#favorite-new-name');
const favoriteNewSave = document.querySelector('#favorite-new-save');
const favoriteNewCancel = document.querySelector('#favorite-new-cancel');
const loginButton = login.querySelector('button');
const status = document.querySelector('#status');
const workspace = document.querySelector('#workspace');
const historyList = document.querySelector('#history-list');
const historyStatus = document.querySelector('#history-status');
const refreshHistory = document.querySelector('#refresh-history');
let signedIn = false;
let pendingSend = null;
let historyGeneration = 0;
let historyEntries = [];
let savedEntries = [];
let favoriteEntries = [];
let favoriteGroups = [];
let favoriteGroupOrder = [0];
let pendingGroupFavorites = [];
let pendingSave = null;

function showSession(authenticated) {
  signedIn = authenticated;
  login.hidden = authenticated;
  form.hidden = !authenticated;
  workspace.hidden = !authenticated;
  account.hidden = !authenticated;
  if (!authenticated) {
    historyGeneration++;
    historyList.replaceChildren();
    renderSaved([]);
    favoriteGroups = [];
    favoriteGroupOrder = [0];
    pendingGroupFavorites = [];
    favoriteNewEditor.hidden = true;
    renderFavorites([]);
  }
  if (authenticated) resizeMessage();
  (authenticated ? message : password).focus();
}

async function request(path, payload, timeout = 15000, method = payload === undefined ? 'GET' : 'POST') {
  const headers = payload === undefined ? {} : { 'Content-Type': 'application/json' };
  if (payload && payload.request_id) headers['X-Request-ID'] = payload.request_id;
  const response = await fetch(`./api/${path}`, {
    method,
    credentials: 'same-origin',
    headers,
    body: payload === undefined ? undefined : JSON.stringify(payload),
    signal: AbortSignal.timeout(timeout),
  });
  if (!response.ok) {
    const error = new Error(await response.text());
    error.status = response.status;
    throw error;
  }
  return response.json();
}

function showError(error, sending = false) {
  status.dataset.error = 'true';
  status.textContent = error instanceof TypeError || error.name === 'TimeoutError'
    ? (sending ? '连接中断或超时，无法确认是否送达。内容已保留，重发前请先检查接收端。' : '连接失败，请检查网络后重试。')
    : error.message;
}

function renderHistory(messages) {
  const seen = new Set();
  historyEntries = messages.filter((entry) => {
    if (seen.has(entry.content)) return false;
    seen.add(entry.content);
    return true;
  }).slice(0, 50);
  const items = historyEntries.map((entry) => {
    const item = document.createElement('button');
    item.type = 'button';
    item.className = 'history-item';
    item.disabled = button.disabled;
    item.title = '点击立即重发这条消息';
    const time = document.createElement('time');
    time.dateTime = entry.received_at;
    time.textContent = new Date(entry.received_at).toLocaleString('zh-CN', { hour12: false });
    const content = document.createElement('span');
    content.className = 'history-content';
    content.textContent = entry.content;
    item.append(time, content);
    attachGesture(item, time, () => favoriteMessage(entry), 'favorite', '松开收藏', () => editMessage(entry), () => sendContent(entry.content, false));
    return item;
  });
  historyList.replaceChildren(...items);
  historyStatus.textContent = items.length ? '' : '还没有历史消息。';
}

function attachGesture(item, label, rightAction, rightKind, rightLabel, leftAction, clickAction, drag = null, leftLabel = '松开编辑') {
  const restingLabel = label.textContent;
  let start = null;
  let suppressClick = false;
  let holdTimer;
  let dragging = false;
  const resetGesture = () => {
    clearTimeout(holdTimer);
    dragging = false;
    start = null;
    delete item.dataset.swipe;
    label.textContent = restingLabel;
  };
  const cancel = () => {
    if (dragging) drag.cancel();
    suppressClick = true;
    resetGesture();
  };
  const begin = (id, x, y) => {
    if (button.disabled) return;
    suppressClick = false;
    start = { id, x, y, axis: null };
    if (drag) holdTimer = setTimeout(() => {
      dragging = true;
      suppressClick = true;
      drag.start();
      label.textContent = '上下拖动 · 松开保存';
    }, 400);
  };
  const move = (x, y, event) => {
    if (!start) return;
    if (dragging) {
      if (event.cancelable) event.preventDefault();
      drag.move(x, y);
      // Moving the card in the DOM releases pointer capture in Chromium.
      if (event.pointerType === 'mouse' || event.pointerType === 'pen') item.setPointerCapture(event.pointerId);
      return;
    }
    const dx = x - start.x;
    const dy = y - start.y;
    // Decide intent early, before the browser turns a thumb's diagonal motion into scrolling.
    if (!start.axis && Math.max(Math.abs(dx), Math.abs(dy)) >= 6) {
      clearTimeout(holdTimer);
      start.axis = Math.abs(dx) > Math.abs(dy) ? 'x' : 'y';
    }
    if (start.axis === 'y') return;
    if (start.axis === 'x' && event.cancelable) event.preventDefault();
    if (start.axis === 'x' && (dx < 0 ? leftAction : rightAction) && Math.abs(dx) >= 36 && Math.abs(dx) > Math.abs(dy) * 1.1) {
      item.dataset.swipe = dx > 0 ? rightKind : 'edit';
      label.textContent = dx > 0 ? rightLabel : leftLabel;
    } else {
      delete item.dataset.swipe;
      label.textContent = restingLabel;
    }
  };
  const finish = (x, y, event) => {
    if (!start) return;
    if (dragging) {
      event.preventDefault();
      resetGesture();
      return drag.end();
    }
    const dx = x - start.x;
    const dy = y - start.y;
    const vertical = start.axis === 'y';
    suppressClick = Math.abs(dx) > 6 || Math.abs(dy) > 6;
    resetGesture();
    if (vertical || Math.abs(dx) < 36 || Math.abs(dx) <= Math.abs(dy) * 1.1) return;
    event.preventDefault();
    if (dx > 0) {
      if (rightAction) return rightAction();
      return;
    }
    if (leftAction) return leftAction();
  };
  // Touch owns finger gestures; Pointer Events are used only for a pen, avoiding duplicate actions.
  item.addEventListener('touchstart', (event) => {
    if (event.touches.length !== 1) { cancel(); return; }
    const touch = event.touches[0];
    begin(touch.identifier, touch.clientX, touch.clientY);
  }, { passive: true });
  item.addEventListener('touchmove', (event) => {
    if (event.touches.length !== 1) { cancel(); return; }
    const touch = event.touches[0];
    if (start && touch.identifier === start.id) move(touch.clientX, touch.clientY, event);
  }, { passive: false });
  item.addEventListener('touchend', (event) => {
    if (event.touches.length) { cancel(); return; }
    const touch = Array.from(event.changedTouches).find((touch) => start && touch.identifier === start.id);
    if (touch) return finish(touch.clientX, touch.clientY, event);
  }, { passive: false });
  item.addEventListener('touchcancel', cancel);
  item.addEventListener('pointerdown', (event) => {
    if ((event.pointerType !== 'pen' && !(drag && event.pointerType === 'mouse')) || event.isPrimary === false) return;
    if (event.pointerType === 'mouse') item.setPointerCapture(event.pointerId);
    begin(event.pointerId, event.clientX, event.clientY);
  });
  item.addEventListener('pointermove', (event) => {
    if ((event.pointerType === 'pen' || event.pointerType === 'mouse') && start && event.pointerId === start.id) move(event.clientX, event.clientY, event);
  });
  item.addEventListener('pointerup', (event) => {
    if ((event.pointerType === 'pen' || event.pointerType === 'mouse') && start && event.pointerId === start.id) return finish(event.clientX, event.clientY, event);
  });
  item.addEventListener('pointercancel', (event) => { if (event.pointerType === 'pen' || event.pointerType === 'mouse') cancel(); });
  item.addEventListener('click', (event) => {
    if (suppressClick && event.detail !== 0) return;
    return clickAction();
  });
}

function renderSaved(entries) {
  savedEntries = entries;
  const items = entries.map((entry) => {
    const row = document.createElement('div');
    row.className = 'saved-row';
    const item = document.createElement('button');
    item.type = 'button';
    item.className = 'history-item saved-item';
    item.disabled = button.disabled;
    const label = document.createElement('span');
    label.className = 'gesture-label';
    label.textContent = '';
    const content = document.createElement('span');
    content.className = 'history-content';
    content.textContent = entry.content;
    item.append(label, content);
    attachGesture(item, label, () => deleteSaved(entry), 'delete', '松开删除', () => editSaved(entry), () => sendContent(entry.content, false, true, entry.id));
    const remove = document.createElement('button');
    remove.type = 'button';
    remove.className = 'delete-saved';
    remove.textContent = '删除';
    remove.disabled = button.disabled;
    remove.addEventListener('click', () => deleteSaved(entry));
    row.append(item, remove);
    return row;
  });
  savedList.replaceChildren(...items);
}

function editMessage(entry) {
  if (button.disabled) return;
  message.value = message.value ? message.value + '\n' + entry.content : entry.content;
  resizeMessage();
  status.dataset.error = 'false';
  status.textContent = '已放回输入框，可继续编辑。';
  message.focus();
}

function editSaved(entry) {
  if (button.disabled) return;
  editMessage(entry);
  status.textContent = '已放回输入框，可继续编辑；暂存消息仍然保留。';
}

function visibleFavorites(groupId) {
  return favoriteEntries.filter((entry) => entry.group_id === groupId).sort((a, b) => {
    if (a.group_position === b.group_position) return 0;
    if (a.group_position === null) return -1;
    if (b.group_position === null) return 1;
    return a.group_position - b.group_position;
  });
}

async function manageFavoriteGroup(path, payload, method = 'POST') {
  setBusy(true);
  historyGeneration++;
  status.dataset.error = 'false';
  status.textContent = '正在保存分组…';
  try {
    const result = await request(path, payload, 15000, method);
    favoriteGroups = result.favorite_groups;
    favoriteGroupOrder = result.favorite_group_order;
    renderFavorites(result.favorites);
    pendingGroupFavorites = [];
    favoriteNewEditor.hidden = true;
    status.textContent = '分组已保存。';
  } catch (error) {
    if (error.status === 401) showSession(false);
    showError(error);
    if (isTransportError(error)) status.textContent = '分组保存结果未确认，请刷新核对；消息内容已保留。';
  } finally {
    setBusy(false);
  }
}

function openFavoriteGroup(ids = []) {
  pendingGroupFavorites = ids;
  favoriteNewEditor.hidden = false;
  favoriteNewName.value = '';
  favoriteNewName.focus();
  favoriteNewGroup.scrollIntoView({ block: 'nearest' });
  status.textContent = ids.length ? '输入新分组名称，创建后移入拖来的消息。' : '输入新分组名称。';
}
favoriteNewOpen.addEventListener('click', () => openFavoriteGroup());
favoriteNewCancel.addEventListener('click', () => {
  pendingGroupFavorites = [];
  favoriteNewEditor.hidden = true;
  status.textContent = '已取消新建分组。';
});
favoriteNewSave.addEventListener('click', () => manageFavoriteGroup('favorite-groups', { name: favoriteNewName.value, ids: pendingGroupFavorites }));

function scrollFavoriteBoard(y) {
  if (y < 32) window.scrollBy(0, -16);
  if (y > window.innerHeight - 32) window.scrollBy(0, 16);
}
function clearFavoriteDrop() {
  for (const box of [...favoriteList.children, favoriteNewGroup]) delete box.dataset.drop;
}

function renderFavorites(entries) {
  favoriteEntries = entries;
  const byId = new Map([{ id: 0, name: '未分组' }, ...favoriteGroups].map((group) => [group.id, group]));
  const boxes = favoriteGroupOrder.map((groupId) => {
    const group = byId.get(groupId);
    const box = document.createElement('section');
    box.className = 'favorite-group-box';
    box.dataset.groupId = String(groupId);
    const heading = document.createElement('button');
    heading.type = 'button';
    heading.className = 'favorite-group-handle';
    heading.title = groupId === 0 ? '长按标题，上下拖动分组排序' : '左滑重命名，长按标题拖动排序';
    heading.disabled = button.disabled;
    const title = document.createElement('span');
    const members = visibleFavorites(groupId);
    title.textContent = `${group.name} · ${members.length}`;
    heading.append(title);
    const body = document.createElement('div');
    body.className = 'favorite-group-items';
    box.append(heading, body);
    let rename = null;
    if (groupId !== 0) {
      const editor = document.createElement('div');
      editor.className = 'group-rename-editor';
      editor.hidden = true;
      const input = document.createElement('input');
      input.maxLength = 40;
      input.ariaLabel = '新的分组名称';
      const save = document.createElement('button');
      save.type = 'button';
      save.textContent = '保存';
      const cancel = document.createElement('button');
      cancel.type = 'button';
      cancel.textContent = '取消';
      editor.append(input, save, cancel);
      box.insertBefore(editor, body);
      rename = () => {
        input.value = group.name;
        editor.hidden = false;
        input.focus();
      };
      const submitRename = () => manageFavoriteGroup(`favorite-groups/${groupId}`, { name: input.value }, 'PATCH');
      save.addEventListener('click', submitRename);
      cancel.addEventListener('click', () => { editor.hidden = true; });
      input.addEventListener('keydown', (event) => {
        if (event.isComposing) return;
        if (event.key === 'Enter') { event.preventDefault(); return submitRename(); }
        if (event.key === 'Escape') { event.preventDefault(); editor.hidden = true; }
      });
    }
    let originalGroupOrder;
    attachGesture(heading, title, null, null, null, rename,
      () => { status.textContent = groupId === 0 ? '长按分组标题后上下拖动排序。' : '左滑分组标题可重命名，长按后上下拖动排序。'; }, {
        start() {
          originalGroupOrder = favoriteGroupOrder.slice();
          historyGeneration++;
          setBusy(true);
          heading.disabled = false;
          box.dataset.dragging = 'true';
          status.dataset.error = 'false';
          status.textContent = '上下拖动整个分组，松开保存顺序。';
        },
        move(x, y) {
          scrollFavoriteBoard(y);
          const before = Array.from(favoriteList.children).find((other) => {
            const rect = other.getBoundingClientRect();
            return other !== box && y < rect.top + rect.height / 2;
          });
          favoriteList.insertBefore(box, before || null);
        },
        async end() {
          const ids = Array.from(favoriteList.children).map((box) => Number(box.dataset.groupId));
          if (ids.every((id, index) => id === originalGroupOrder[index])) {
            renderFavorites(favoriteEntries);
            setBusy(false);
            status.textContent = '分组顺序未改变。';
            return;
          }
          await manageFavoriteGroup('favorite-groups/order', { ids });
          // A rejected or uncertain save displays the original known order.
          renderFavorites(favoriteEntries);
        },
        cancel() {
          renderFavorites(favoriteEntries);
          setBusy(false);
          status.textContent = '已取消分组排序。';
        },
      }, '松开重命名');
    heading.addEventListener('contextmenu', (event) => event.preventDefault());
    const rows = members.map((entry) => {
      const row = document.createElement('div');
      row.className = 'favorite-row';
      row.dataset.favoriteId = entry.id;
      const item = document.createElement('button');
      item.type = 'button';
      item.className = 'history-item favorite-item';
      item.disabled = button.disabled;
      const label = document.createElement('span');
      label.className = 'gesture-label';
      label.textContent = '';
      const content = document.createElement('span');
      content.className = 'history-content';
      content.textContent = entry.content;
      item.append(label, content);
      let original;
      let target;
      let ordered;
      const restore = () => {
        clearFavoriteDrop();
        renderFavorites(original);
        setBusy(false);
      };
      attachGesture(item, label, () => changeFavorite(entry, true), 'delete', '松开取消收藏',
        () => editMessage(entry), () => sendContent(entry.content, false), {
          start() {
            original = favoriteEntries.slice();
            target = groupId;
            ordered = members.map((entry) => entry.id);
            historyGeneration++;
            setBusy(true);
            item.disabled = false;
            item.dataset.dragging = 'true';
            status.dataset.error = 'false';
            status.textContent = '拖入分组框调整消息，或拖到「新建分组」。';
          },
          move(x, y) {
            scrollFavoriteBoard(y);
            clearFavoriteDrop();
            const destination = [...favoriteList.children, favoriteNewGroup].find((other) => {
              const rect = other.getBoundingClientRect();
              return x >= rect.left && x <= rect.right && y >= rect.top && y <= rect.bottom;
            });
            if (!destination) { target = null; return; }
            destination.dataset.drop = 'true';
            if (destination === favoriteNewGroup) { target = 'new'; return; }
            target = Number(destination.dataset.groupId);
            const container = destination.querySelector('.favorite-group-items');
            const before = Array.from(container.children).find((other) => {
              const rect = other.getBoundingClientRect();
              return other !== row && y < rect.top + rect.height / 2;
            });
            container.insertBefore(row, before || null);
            ordered = Array.from(container.children).map((row) => Number(row.dataset.favoriteId));
          },
          async end() {
            clearFavoriteDrop();
            delete item.dataset.dragging;
            if (target === 'new') {
              restore();
              openFavoriteGroup([entry.id]);
              return;
            }
            if (target === null) { restore(); status.textContent = '已取消移动。'; return; }
            if (target !== groupId) {
              await manageFavoriteGroup('favorites/move', { ids: [entry.id], group_id: target, order: ordered });
              renderFavorites(favoriteEntries);
              return;
            }
            if (ordered.every((id, index) => id === members[index].id)) {
              restore();
              status.textContent = '收藏顺序未改变。';
              return;
            }
            item.disabled = true;
            status.textContent = '正在保存收藏顺序…';
            try {
              const result = await request('favorites/order', { ids: ordered, group_id: groupId });
              renderFavorites(result.favorites);
              status.textContent = '收藏顺序已保存。';
            } catch (error) {
              renderFavorites(original);
              if (error.status === 401) showSession(false);
              showError(error);
              if (isTransportError(error)) status.textContent = '排序保存结果未确认，请刷新核对。';
            } finally { setBusy(false); }
          },
          cancel() { restore(); status.textContent = '已取消排序。'; },
        });
      item.addEventListener('contextmenu', (event) => event.preventDefault());
      row.append(item);
      return row;
    });
    body.append(...rows);
    return box;
  });
  favoriteList.replaceChildren(...boxes);
}

function favoriteMessage(entry) {
  return changeFavorite(entry, false);
}

async function changeFavorite(entry, removing) {
  if (button.disabled) return;
  setBusy(true);
  historyGeneration++;
  status.dataset.error = 'false';
  status.textContent = removing ? '正在取消收藏…' : '正在收藏…';
  try {
    if (removing) {
      await request(`favorites/${entry.id}`, undefined, 15000, 'DELETE');
      renderFavorites(favoriteEntries.filter((item) => item.id !== entry.id));
    } else {
      const result = await request('favorites', { message: entry.content, group_id: 0 });
      if (!favoriteEntries.some((item) => item.id === result.id)) renderFavorites([result, ...favoriteEntries]);
    }
    status.textContent = removing ? '已取消收藏。' : '已收藏，可在收藏区反复发送。';
  } catch (error) {
    if (error.status === 401) showSession(false);
    showError(error);
  } finally {
    setBusy(false);
  }
}

async function deleteSaved(entry) {
  if (button.disabled) return;
  setBusy(true);
  historyGeneration++;
  status.dataset.error = 'false';
  status.textContent = '正在删除暂存消息…';
  try {
    await request(`saved/${entry.id}`, undefined, 15000, 'DELETE');
    renderSaved(savedEntries.filter((item) => item.id !== entry.id));
    if (pendingSave && pendingSave.request_id === entry.id) pendingSave = null;
    if (pendingSend && pendingSend.request_id === entry.id) pendingSend = null;
    status.textContent = '已删除暂存消息。';
  } catch (error) {
    if (error.status === 401) showSession(false);
    status.dataset.error = 'true';
    status.textContent = isTransportError(error)
      ? '删除结果未确认，条目已保留，可再次点击删除核对。'
      : error.message;
  } finally {
    setBusy(false);
  }
}

function newRequestId() {
  return Array.from(crypto.getRandomValues(new Uint8Array(16)), (value) => value.toString(16).padStart(2, '0')).join('');
}

function setBusy(busy) {
  for (const control of [button, leftButton, draftButton, saveButton, logout, refreshHistory, favoriteNewOpen, favoriteNewName, favoriteNewSave, favoriteNewCancel]) control.disabled = busy;
  for (const list of [historyList, savedList, favoriteList]) list.querySelectorAll('button, input').forEach((item) => { item.disabled = busy; });
  message.readOnly = busy;
}

async function loadHistory() {
  const generation = ++historyGeneration;
  refreshHistory.disabled = true;
  historyStatus.dataset.error = 'false';
  historyStatus.textContent = '正在加载…';
  try {
    const result = await request('messages');
    if (!signedIn || generation !== historyGeneration) return;
    renderHistory(result.messages);
    renderSaved(result.saved);
    favoriteGroups = result.favorite_groups;
    favoriteGroupOrder = result.favorite_group_order;
    renderFavorites(result.favorites);
  } catch (error) {
    if (generation !== historyGeneration) return;
    if (error.status === 401) showSession(false);
    historyStatus.dataset.error = 'true';
    historyStatus.textContent = '历史消息加载失败，请点击刷新重试。';
    if (error.status === 401) showError(error);
  } finally {
    if (generation === historyGeneration) refreshHistory.disabled = button.disabled;
  }
}
refreshHistory.addEventListener('click', loadHistory);

login.addEventListener('submit', async (event) => {
  event.preventDefault();
  if (loginButton.disabled) return;
  loginButton.disabled = true;
  status.textContent = '正在登录…';
  status.dataset.error = 'false';
  try {
    await request('login', { password: password.value });
    let state;
    try {
      state = await request('messages');
    } catch (error) {
      if (error.status === 401) throw new Error('浏览器未保留登录 Cookie。请允许本站保存 Cookie，并使用同一个 HTTPS 地址访问。');
      throw error;
    }
    password.value = '';
    showSession(true);
    status.textContent = '';
    renderHistory(state.messages);
    renderSaved(state.saved);
    favoriteGroups = state.favorite_groups;
    favoriteGroupOrder = state.favorite_group_order;
    renderFavorites(state.favorites);
  } catch (error) {
    showError(error);
  } finally {
    loginButton.disabled = false;
  }
});

logout.addEventListener('click', async () => {
  if (logout.disabled) return;
  logout.disabled = true;
  try {
    await request('logout', {});
    showSession(false);
    status.dataset.error = 'false';
    status.textContent = '已退出登录。';
  } catch (error) {
    showError(error);
  } finally {
    logout.disabled = false;
  }
});

function isTransportError(error) {
  return error instanceof TypeError || error.name === 'TimeoutError';
}

async function confirmReceipt(requestId) {
  for (let attempt = 0; attempt < 3; attempt++) {
    if (attempt) await new Promise((resolve) => setTimeout(resolve, 500));
    try {
      const result = await request(`requests/${requestId}`, undefined, 5000);
      if (result.status === 'sent') return result;
    } catch (error) {
      if (!isTransportError(error) && error.status !== 404 && !(error.status >= 500)) throw error;
    }
  }
  throw new Error(`发送结果暂未确认（编号 ${requestId.slice(0, 8)}）。内容已保留；再次发送相同内容会沿用原编号，服务器不会重复转发。`);
}

async function sendContent(content, clearDraft, submit = true, savedId = null) {
  if (button.disabled) return;
  if (!content.trim()) {
    showError(new Error('请输入消息。'));
    message.focus();
    return;
  }
  if (!pendingSend || pendingSend.message !== content || pendingSend.submit !== submit || (savedId && pendingSend.request_id !== savedId)) {
    pendingSend = { message: content, submit, request_id: savedId || newRequestId() };
  }
  const sending = pendingSend;
  let confirmed = false;
  setBusy(true);
  status.dataset.error = 'false';
  status.textContent = '正在发送…';
  try {
    let result;
    try {
      result = await request('messages', sending);
    } catch (error) {
      if (!isTransportError(error) && !(error.status >= 500)) throw error;
      status.textContent = '正在核对服务器回执…';
      result = await confirmReceipt(sending.request_id);
    }
    if (result.status === 'pending') {
      status.textContent = '服务器已收录，正在确认转发结果…';
      result = await confirmReceipt(sending.request_id);
    }
    status.textContent = result.receivers > 0
      ? (submit ? `已发送到 ${result.receivers} 个接收端。` : `已贴入 ${result.receivers} 个接收端，未按回车，可继续编辑。`)
      : '已存档，但没有接收端在线；这条消息不会自动补发。';
    historyGeneration++;
    renderHistory([{ id: result.message_id, received_at: new Date().toISOString(), content }, ...historyEntries]);
    historyList.scrollTop = 0;
    if (clearDraft) {
      message.value = '';
      resizeMessage();
    }
    if (savedId) renderSaved(savedEntries.filter((entry) => entry.id !== savedId));
    pendingSend = null;
    confirmed = true;
  } catch (error) {
    if (error.status === 401) showSession(false);
    showError(error, true);
  } finally {
    setBusy(false);
    if (!form.hidden) message.focus();
  }
  if (confirmed && signedIn) void loadHistory();
}

form.addEventListener('submit', async (event) => {
  event.preventDefault();
  await sendContent(message.value, true);
});
draftButton.addEventListener('click', () => sendContent(message.value, true, false));
saveButton.addEventListener('click', async () => {
  if (button.disabled) return;
  const content = message.value;
  if (!content.trim()) {
    showError(new Error('请输入要暂存的消息。'));
    return;
  }
  if (!pendingSave || pendingSave.message !== content) pendingSave = { message: content, request_id: newRequestId() };
  setBusy(true);
  status.dataset.error = 'false';
  status.textContent = '正在暂存…';
  try {
    const result = await request('saved', pendingSave);
    renderSaved([result, ...savedEntries.filter((entry) => entry.id !== result.id)]);
    pendingSave = null;
    message.value = '';
    resizeMessage();
    status.textContent = '已暂存，点击下方黄色消息即可发送。';
  } catch (error) {
    if (error.status === 401) showSession(false);
    status.dataset.error = 'true';
    status.textContent = isTransportError(error)
      ? '暂存结果未确认，原文已保留；再次暂存相同内容不会生成重复条目。'
      : error.message;
  } finally {
    setBusy(false);
    if (signedIn) message.focus();
  }
});

function resizeMessage() {
  message.style.height = 'auto';
  // scrollHeight includes padding; add the two 1px borders for border-box sizing.
  message.style.height = `${message.scrollHeight + 2}px`;
}
message.addEventListener('input', resizeMessage);
window.addEventListener('resize', resizeMessage);

message.addEventListener('keydown', (event) => {
  if (event.key !== 'Enter' || event.isComposing || event.keyCode === 229) return;
  if (event.shiftKey && !event.ctrlKey && !event.metaKey) return;
  event.preventDefault();
  form.requestSubmit(button);
});

const initialState = JSON.parse(document.querySelector('#initial-state').content.textContent);
showSession(initialState.authenticated);
status.textContent = '';
if (initialState.authenticated) {
  renderHistory(initialState.messages);
  renderSaved(initialState.saved);
  favoriteGroups = initialState.favorite_groups;
  favoriteGroupOrder = initialState.favorite_group_order;
  renderFavorites(initialState.favorites);
}
"""

WEB_STYLE = r""":root { font-family: system-ui, sans-serif; color: #172c2a; background: #f2f5f1; }
